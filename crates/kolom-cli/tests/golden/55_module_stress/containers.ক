তথ্য বাক্স<T> {
    মান: T
}

এনাম বিকল্প<T> {
    কিছু(T),
    কিছুই_না
}

ফাংশন প্রথম<T>(T[] তালিকা) -> বিকল্প<T> {
    যদি (দৈর্ঘ্য(তালিকা) == ০) {
        রিটার্ন কিছুই_না()
    }
    রিটার্ন কিছু(তালিকা[০])
}

ফাংশন খুলুন<T>(বিকল্প<T> b, T ডিফল্ট) -> T {
    রিটার্ন মিলাও b {
        কিছু(v) => v,
        কিছুই_না => ডিফল্ট,
    }
}
