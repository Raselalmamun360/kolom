ইম্পোর্ট ast

ফাংশন মূল্যায়ন(Expr e) -> সংখ্যা {
    রিটার্ন মিলাও e {
        Num(n) => n,
        Add(l, r) => মূল্যায়ন(মান(l)) + মূল্যায়ন(মান(r)),
        Sub(l, r) => মূল্যায়ন(মান(l)) - মূল্যায়ন(মান(r)),
        Mul(l, r) => মূল্যায়ন(মান(l)) * মূল্যায়ন(মান(r)),
        Div(l, r) => মূল্যায়ন(মান(l)) / মূল্যায়ন(মান(r)),
        Neg(x) => -মূল্যায়ন(মান(x)),
    }
}
