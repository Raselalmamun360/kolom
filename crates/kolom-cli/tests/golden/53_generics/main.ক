তথ্য বাক্স<T> {
    মান: T
}

এনাম বিকল্প<T> {
    কিছু(T),
    কিছুই_না
}

ফাংশন প্রথম<T>(T[] তালিকা) -> T {
    রিটার্ন তালিকা[০]
}

ফাংশন খুলুন<T>(বিকল্প<T> b, T ডিফল্ট) -> T {
    রিটার্ন মিলাও b {
        কিছু(v) => v,
        কিছুই_না => ডিফল্ট,
    }
}

অ্যাপ {
    ধরি ক: বাক্স<সংখ্যা> = বাক্স(৪২)
    লেখো(লেখায়(ক.মান))

    ধরি খ = বাক্স("হ্যালো")
    লেখো(খ.মান)

    ধরি তালিকা = [১০, ২০, ৩০]
    লেখো(লেখায়(প্রথম(তালিকা)))

    ধরি সবুজ: বিকল্প<সংখ্যা> = কিছু(৭)
    ধরি লাল: বিকল্প<সংখ্যা> = কিছুই_না()

    লেখো(লেখায়(খুলুন(সবুজ, ০)))
    লেখো(লেখায়(খুলুন(লাল, -১)))
}
