// একটা 'তথ্য'-এর ফিল্ড একটা 'এনাম' হতে পারে — টোকেন মডেলের মূল আকৃতি।
// 'তথ্য'-টা এখানে ইচ্ছাকৃতভাবে 'এনাম'-এর আগে ঘোষিত, ফরওয়ার্ড-রেফারেন্স
// কাজ করে তা দেখাতে।

তথ্য টোকেন {
    ধরন: টোকেন_ধরন,
    শুরু: সংখ্যা
}

এনাম টোকেন_ধরন {
    সংখ্যা_টোকেন(সংখ্যা),
    নাম_টোকেন(লেখা),
    শেষ
}

তথ্য মোড়ক {
    এক: শেয়ার টোকেন_ধরন,
    সব: টোকেন_ধরন[]
}

ফাংশন ধরন_নাম(টোকেন_ধরন t) -> লেখা {
    রিটার্ন মিলাও t {
        সংখ্যা_টোকেন(n) => "সংখ্যা:" + লেখায়(n),
        নাম_টোকেন(s) => "নাম:" + s,
        শেষ => "শেষ",
    }
}

অ্যাপ {
    ধরি ট: টোকেন[] = []
    যোগ_করো(ট, টোকেন(নাম_টোকেন("ধরি"), ০))
    যোগ_করো(ট, টোকেন(সংখ্যা_টোকেন(৪২), ৫))
    যোগ_করো(ট, টোকেন(শেষ(), ৭))

    প্রতি (t : ট) {
        লেখো(ধরন_নাম(t.ধরন) + " @" + লেখায়(t.শুরু))
    }

    // ফিল্ডে অ্যাসাইনমেন্ট
    ধরি প্রথম = ট[০]
    প্রথম.ধরন = শেষ()
    লেখো(ধরন_নাম(প্রথম.ধরন))

    // শেয়ার/অ্যারে-মোড়ানো এনাম ফিল্ড
    ধরি m = মোড়ক(শেয়ার_করো(সংখ্যা_টোকেন(৭)), [শেষ(), নাম_টোকেন("ক")])
    লেখো(ধরন_নাম(মান(m.এক)))
    লেখো(ধরন_নাম(m.সব[১]))
}
