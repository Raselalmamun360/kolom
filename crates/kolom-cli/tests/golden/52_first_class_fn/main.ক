ফাংশন বর্গ(সংখ্যা x) -> সংখ্যা {
    রিটার্ন x * x
}

ফাংশন ঘন(সংখ্যা x) -> সংখ্যা {
    রিটার্ন x * x * x
}

ফাংশন প্রয়োগ(সংখ্যা x, (সংখ্যা) -> সংখ্যা f) -> সংখ্যা {
    রিটার্ন f(x)
}

অ্যাপ {
    ধরি f: (সংখ্যা) -> সংখ্যা = বর্গ
    লেখো(লেখায়(f(৫)))

    লেখো(লেখায়(প্রয়োগ(৪, বর্গ)))
    লেখো(লেখায়(প্রয়োগ(৪, ঘন)))

    ধরি টেবিল = [বর্গ, ঘন]
    প্রতি (g : টেবিল) {
        লেখো(লেখায়(g(৩)))
    }
}
