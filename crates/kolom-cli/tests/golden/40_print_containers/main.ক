ডাটা একক {
    মান: সংখ্যা
}

অ্যাপ {

    // অ্যারে প্রিন্ট — ক্রম সবসময় নির্দিষ্ট (Vec, hash map নয়)
    ধরি সংখ্যাগুলো = [১, ২, ৩]
    লেখো(সংখ্যাগুলো)

    ধরি নামগুলো = ["ক", "খ"]
    লেখো(নামগুলো)

    ধরি খালি: সংখ্যা[] = []
    লেখো(খালি)

    // নেস্টেড অ্যারে
    ধরি নেস্টেড = [[১, ২], [৩, ৪, ৫]]
    লেখো(নেস্টেড)

    // এক-ফিল্ড struct ও এক-এন্ট্রি ম্যাপ — এখানে ফিল্ড/এন্ট্রি ক্রম
    // অস্পষ্ট নয় (একটাই আছে), তাই এই দুটোও নির্দিষ্ট আউটপুট দেয়।
    // একাধিক ফিল্ড/এন্ট্রি সহ কনটেইনার প্রিন্ট (ক্রম বাদে বিষয়বস্তু
    // সঠিক কিনা) golden_m2.rs-এর print_multi_field_containers-এ যাচাই হয়,
    // কারণ ইন্টারপ্রেটার struct/ম্যাপ-কে HashMap দিয়ে প্রতিনিধিত্ব করে
    // বলে তাদের প্রিন্ট-ক্রম রান থেকে রানে বদলাতে পারে।
    ধরি একটা = একক(৭)
    লেখো(একটা)

    ধরি ম: ম্যাপ[লেখা, সংখ্যা] = ম্যাপ_তৈরি()
    ম["ক"] = ১
    লেখো(ম)

}
