// UI উইজেটের নামগুলো কনটেক্সচুয়াল — শুধু 'ডিসপ্লে' ব্লকের ভেতরে উইজেট,
// বাইরে সাধারণ নাম। আর প্রিমিটিভ টাইপের নাম *মেম্বার*-পজিশনে (ফিল্ডের নাম,
// '.'-এর পরে) নামই, টাইপ নয়। কম্পাইলার-উৎস এই দুটোই চায়:
// 'ডায়াগনস্টিক { কলাম }', 'টোকেন { লেখা }'।

তথ্য ডায়াগনস্টিক {
    বার্তা: লেখা,
    লাইন: সংখ্যা,
    কলাম: সংখ্যা
}

তথ্য টোকেন {
    লেখা: লেখা,
    সংখ্যা: সংখ্যা,
    অক্ষর: অক্ষর
}

ফাংশন সারি(সংখ্যা n) -> সংখ্যা {
    রিটার্ন n * ২
}

অ্যাপ {
    ধরি d = ডায়াগনস্টিক("স্ট্রিং বন্ধ হয়নি", ৩, ৭)
    লেখো(d.বার্তা + " @" + লেখায়(d.লাইন) + ":" + লেখায়(d.কলাম))

    ধরি t = টোকেন("ধরি", ৩, 'ক')
    লেখো(t.লেখা + " " + লেখায়(t.সংখ্যা) + " " + লেখায়(t.অক্ষর))
    t.সংখ্যা = ৯
    লেখো(লেখায়(t.সংখ্যা))

    // উইজেট-নাম সাধারণ আইডেন্টিফায়ার হিসেবে
    ধরি টেক্সট = "হ্যালো"
    ধরি ইনপুট = ৫
    ধরি ছবি: লেখা[] = []
    যোগ_করো(ছবি, টেক্সট)
    লেখো(লেখায়(সারি(ইনপুট)) + " " + ছবি[০] + " " + লেখায়(দৈর্ঘ্য(ছবি)))
}
