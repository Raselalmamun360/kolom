এনাম আকৃতি {
    বৃত্ত(দশমিক),
    আয়তক্ষেত্র(দশমিক, দশমিক),
    বিন্দু
}

ফাংশন ক্ষেত্রফল(আকৃতি আ) -> দশমিক {
    রিটার্ন মিলাও আ {
        বৃত্ত(ব্যাসার্ধ) => ৩.০ * ব্যাসার্ধ * ব্যাসার্ধ,
        আয়তক্ষেত্র(দৈর্ঘ্য, প্রস্থ) => দৈর্ঘ্য * প্রস্থ,
        বিন্দু => ০.০,
    }
}

এনাম Expr {
    Lit(সংখ্যা),
    Add(শেয়ার Expr, শেয়ার Expr)
}

ফাংশন মান_এক্সপ্র(Expr e) -> সংখ্যা {
    রিটার্ন মিলাও e {
        Lit(n) => n,
        Add(l, r) => মান_এক্সপ্র(মান(l)) + মান_এক্সপ্র(মান(r)),
    }
}

অ্যাপ {
    ধরি ক = বৃত্ত(২.০)
    ধরি খ = আয়তক্ষেত্র(৩.০, ৪.০)
    ধরি গ = বিন্দু()

    লেখো(লেখায়(ক্ষেত্রফল(ক)))
    লেখো(লেখায়(ক্ষেত্রফল(খ)))
    লেখো(লেখায়(ক্ষেত্রফল(গ)))

    ধরি যোগফল = Add(শেয়ার_করো(Lit(২)), শেয়ার_করো(Add(শেয়ার_করো(Lit(৩)), শেয়ার_করো(Lit(৪)))))
    লেখো(লেখায়(মান_এক্সপ্র(যোগফল)))

    ধরি ঘ = বিন্দু()
    ধরি বর্ণনা = মিলাও ঘ {
        _ => "কিছু একটা আকৃতি",
    }
    লেখো(বর্ণনা)
}
