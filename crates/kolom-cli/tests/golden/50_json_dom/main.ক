ইম্পোর্ট জেসন_মডিউল

অ্যাপ {

    // নেস্টেড: object, array, string, number (int + fraction + negative),
    // bool, null — সবগুলো একসাথে
    ধরি পাঠ্য = "{\"নাম\": \"রহিম\", \"বয়স\": 25, \"পাস\": true, \"ভুল\": false, \"খালি\": null, \"গড়\": -3.5, \"বন্ধু\": [\"করিম\", \"সেলিনা\"], \"ঠিকানা\": {\"শহর\": \"ঢাকা\", \"জিপ\": 1207}}"

    ধরি মান = জেসন_পার্স(পাঠ্য)

    লেখো(লেখায়(জেসন_বস্তু_কি(মান)))

    লেখো(জেসন_ক্ষেত্র(মান, "নাম").লেখা_মান)

    লেখো(লেখায়(জেসন_ক্ষেত্র(মান, "বয়স").সংখ্যা_মান))

    লেখো(লেখায়(জেসন_ক্ষেত্র(মান, "পাস").বুলিয়ান_মান))

    লেখো(লেখায়(জেসন_ক্ষেত্র(মান, "ভুল").বুলিয়ান_মান))

    লেখো(লেখায়(জেসন_নাল_কি(জেসন_ক্ষেত্র(মান, "খালি"))))

    লেখো(লেখায়(জেসন_ক্ষেত্র(মান, "গড়").সংখ্যা_মান))

    // নেস্টেড অ্যারে
    ধরি বন্ধুরা = জেসন_ক্ষেত্র(মান, "বন্ধু")
    লেখো(লেখায়(দৈর্ঘ্য(বন্ধুরা.তালিকা_মান)))
    লেখো(বন্ধুরা.তালিকা_মান[০].লেখা_মান)
    লেখো(বন্ধুরা.তালিকা_মান[১].লেখা_মান)

    // নেস্টেড অবজেক্ট
    ধরি ঠিকানা = জেসন_ক্ষেত্র(মান, "ঠিকানা")
    লেখো(জেসন_ক্ষেত্র(ঠিকানা, "শহর").লেখা_মান)
    লেখো(লেখায়(জেসন_ক্ষেত্র(ঠিকানা, "জিপ").সংখ্যা_মান))

    // অনুপস্থিত কী -> null, ত্রুটি নয়
    লেখো(লেখায়(জেসন_নাল_কি(জেসন_ক্ষেত্র(মান, "নেই"))))

    // এস্কেপ-সহ স্ট্রিং রাউন্ড-ট্রিপ
    ধরি এস্কেপড = জেসন_পার্স("\"লাইন১\\nলাইন২ আর \\\"উদ্ধৃতি\\\"\"")
    লেখো(এস্কেপড.লেখা_মান)

    // খালি অ্যারে ও খালি অবজেক্ট
    ধরি খালি_তালিকা = জেসন_পার্স("[]")
    লেখো(লেখায়(দৈর্ঘ্য(খালি_তালিকা.তালিকা_মান)))

    ধরি খালি_বস্তু = জেসন_পার্স("{}")
    লেখো(লেখায়(দৈর্ঘ্য(চাবি_গুলো(খালি_বস্তু.বস্তু_মান))))

    // সিরিয়ালাইজ — রাউন্ড-ট্রিপ করে আবার পার্স করে যাচাই (key order অনির্দিষ্ট
    // বলে টেক্সট সরাসরি না মিলিয়ে)
    ধরি মূল_ম্যাপ: ম্যাপ[লেখা, জেসন_মান] = ম্যাপ_তৈরি()
    মূল_ম্যাপ["x"] = জেসন_সংখ্যা(1.0)
    মূল_ম্যাপ["y"] = জেসন_তালিকা([জেসন_সংখ্যা(1.0), জেসন_সংখ্যা(2.0)])
    ধরি মূল = জেসন_বস্তু(মূল_ম্যাপ)
    ধরি লেখা_আকারে = জেসন_লেখো(মূল)
    ধরি আবার_পার্স = জেসন_পার্স(লেখা_আকারে)
    লেখো(লেখায়(জেসন_ক্ষেত্র(আবার_পার্স, "x").সংখ্যা_মান))
    লেখো(লেখায়(দৈর্ঘ্য(জেসন_ক্ষেত্র(আবার_পার্স, "y").তালিকা_মান)))

    // পূর্ণাঙ্গ round-trip সরল মানে
    লেখো(জেসন_লেখো(জেসন_বুল(সত্য)))
    লেখো(জেসন_লেখো(জেসন_নাল()))
    লেখো(জেসন_লেখো(জেসন_লেখা("ক\"খ")))

    // অবৈধ ইনপুট -> জেসন_ত্রুটি ট্যাগ, রানটাইম প্যানিক নয়
    ধরি খারাপ = জেসন_পার্স("@@@")
    লেখো(লেখায়(জেসন_ত্রুটি_কি(খারাপ)))

}
