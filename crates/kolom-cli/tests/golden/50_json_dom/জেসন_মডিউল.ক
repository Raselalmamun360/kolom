// জেসন_মডিউল — একটা সম্পূর্ণ, নেস্টেড JSON DOM: পার্সার + সিরিয়ালাইজার,
// সম্পূর্ণ কলম সোর্সে লেখা, kolom-runtime-এ কোনো নতুন ফাংশন ছাড়াই।
//
// কেন runtime-এ নয়: জেসন_মান-এর মতো একটা কাস্টম struct-এর ফিল্ড-লেআউট
// (কয়টা ফিল্ড, কোন অফসেটে, কোন ড্রপ-ফাংশন) ঠিক হয় প্রতিটা কলম প্রোগ্রাম
// আলাদাভাবে কম্পাইল হওয়ার সময়, kolom-codegen-cranelift দিয়ে। কিন্তু
// kolom-runtime একটা স্বতন্ত্র Rust ক্রেট, যেটা কম্পাইল হয় একবার, যেকোনো
// ব্যবহারকারীর .ক ফাইল লেখার আগেই — তাই runtime-এর ভেতরের কোনো Rust কোড
// জেসন_মান-এর গঠন জানতেই পারে না। যে কম্পাইলার পাস জেসন_মান-এর গঠন
// ঠিক করে, সেই একই পাস এই পার্সার কোডও কম্পাইল করে — তাই এখানে কোনো
// সমস্যাই নেই, যদি এই পুরো জিনিসটা সাধারণ কলম সোর্স হিসেবে লেখা হয়।
//
// সীমাবদ্ধতা (v1): স্ট্রিং-এ \uXXXX ইউনিকোড এসকেপ সমর্থিত না (শুধু
// \" \\ \/ \n \t \r)। বড় তালিকা পার্স করা O(n²) (প্রতিটা উপাদানে অ্যারে
// কনক্যাট) — বিশাল JSON-এ ধীর হতে পারে, কিন্তু সঠিক।

ইম্পোর্ট লেখা

তথ্য জেসন_মান {
    ট্যাগ: সংখ্যা,
    বুলিয়ান_মান: বুলিয়ান,
    সংখ্যা_মান: দশমিক,
    লেখা_মান: লেখা,
    তালিকা_মান: জেসন_মান[],
    বস্তু_মান: ম্যাপ[লেখা, জেসন_মান]
}

ধ্রুবক জেসন_নাল_ট্যাগ: সংখ্যা = ০
ধ্রুবক জেসন_বুল_ট্যাগ: সংখ্যা = ১
ধ্রুবক জেসন_সংখ্যা_ট্যাগ: সংখ্যা = ২
ধ্রুবক জেসন_লেখা_ট্যাগ: সংখ্যা = ৩
ধ্রুবক জেসন_তালিকা_ট্যাগ: সংখ্যা = ৪
ধ্রুবক জেসন_বস্তু_ট্যাগ: সংখ্যা = ৫
ধ্রুবক জেসন_ত্রুটি_ট্যাগ: সংখ্যা = ৬

// ---- কনস্ট্রাক্টর ----

// কম্পাইলড ব্যাকএন্ড constructor-argument পজিশনে `[]`/`ম্যাপ_তৈরি()`-এর
// টাইপ অনুমান করতে পারে না (সেমা/ইন্টারপ্রেটার পারে, কিন্তু কোডজেন পারে
// না — দুটোরই টাইপ প্রসঙ্গ থেকে অনুমান করতে হয়, যা এক্সপ্লিসিট-টাইপ
// `ধরি` বাইন্ডিং-এ থাকে, কিন্তু বেয়ার আর্গুমেন্ট পজিশনে কোডজেন সেই
// প্রসঙ্গ থ্রেড করে না) — তাই প্রতিটা কনস্ট্রাক্টরে বেয়ার `[]`/
// `ম্যাপ_তৈরি()` লেখার বদলে এই দুইটা এক্সপ্লিসিট-টাইপ হেল্পার
// পুনর্ব্যবহার করা হয়েছে।
ফাংশন জেসন_খালি_তালিকা() -> জেসন_মান[] {
    ধরি খ: জেসন_মান[] = []
    রিটার্ন খ
}

ফাংশন জেসন_খালি_বস্তু_ম্যাপ() -> ম্যাপ[লেখা, জেসন_মান] {
    ধরি ম: ম্যাপ[লেখা, জেসন_মান] = ম্যাপ_তৈরি()
    রিটার্ন ম
}

ফাংশন জেসন_নাল() -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_নাল_ট্যাগ, মিথ্যা, ০.০, "", জেসন_খালি_তালিকা(), জেসন_খালি_বস্তু_ম্যাপ())
}

ফাংশন জেসন_বুল(বুলিয়ান খ) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_বুল_ট্যাগ, খ, ০.০, "", জেসন_খালি_তালিকা(), জেসন_খালি_বস্তু_ম্যাপ())
}

ফাংশন জেসন_সংখ্যা(দশমিক ন) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_সংখ্যা_ট্যাগ, মিথ্যা, ন, "", জেসন_খালি_তালিকা(), জেসন_খালি_বস্তু_ম্যাপ())
}

ফাংশন জেসন_লেখা(লেখা স) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_লেখা_ট্যাগ, মিথ্যা, ০.০, স, জেসন_খালি_তালিকা(), জেসন_খালি_বস্তু_ম্যাপ())
}

ফাংশন জেসন_তালিকা(জেসন_মান[] ত) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_তালিকা_ট্যাগ, মিথ্যা, ০.০, "", ত, জেসন_খালি_বস্তু_ম্যাপ())
}

ফাংশন জেসন_বস্তু(ম্যাপ[লেখা, জেসন_মান] ব) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_বস্তু_ট্যাগ, মিথ্যা, ০.০, "", জেসন_খালি_তালিকা(), ব)
}

ফাংশন জেসন_ত্রুটি(লেখা বার্তা) -> জেসন_মান {
    রিটার্ন জেসন_মান(জেসন_ত্রুটি_ট্যাগ, মিথ্যা, ০.০, বার্তা, জেসন_খালি_তালিকা(), জেসন_খালি_বস্তু_ম্যাপ())
}

// ---- ট্যাগ-চেক ----

ফাংশন জেসন_নাল_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_নাল_ট্যাগ
}

ফাংশন জেসন_বুল_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_বুল_ট্যাগ
}

ফাংশন জেসন_সংখ্যা_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_সংখ্যা_ট্যাগ
}

ফাংশন জেসন_লেখা_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_লেখা_ট্যাগ
}

ফাংশন জেসন_তালিকা_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_তালিকা_ট্যাগ
}

ফাংশন জেসন_বস্তু_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_বস্তু_ট্যাগ
}

ফাংশন জেসন_ত্রুটি_কি(জেসন_মান ভ) -> বুলিয়ান {
    রিটার্ন ভ.ট্যাগ == জেসন_ত্রুটি_ট্যাগ
}

// অবজেক্টে কী না থাকলে ত্রুটি না দিয়ে জেসন_নাল() — সাধারণ JSON API কনভেনশন।
ফাংশন জেসন_ক্ষেত্র(জেসন_মান ব, লেখা কী) -> জেসন_মান {
    যদি (আছে_কি(ব.বস্তু_মান, কী)) {
        রিটার্ন ব.বস্তু_মান[কী]
    }
    রিটার্ন জেসন_নাল()
}

// ---- পার্সার ----

ফাংশন জেসন_বর্তমান(লেখা স, শেয়ার সংখ্যা কার্সার) -> লেখা {
    ধরি i = মান(কার্সার)
    যদি (i >= দৈর্ঘ্য(স)) {
        রিটার্ন ""
    }
    // `রিটার্ন লেখা.স্লাইস(...)`-এর বদলে আগে বাইন্ড করে তারপর রিটার্ন —
    // পার্সারে একটা বাগ পাওয়া গেছে, `রিটার্ন` সরাসরি `লেখা.` দিয়ে শুরু
    // qualified call দেখলে ব্যর্থ হয় (`লেখা` টাইপ-কীওয়ার্ড আর মডিউল নাম
    // দুটোই হওয়ায় সম্ভবত একটা পার্স-অ্যাম্বিগুইটি) — অন্য কোনো মডিউলে
    // (যেমন `গণিত`) এই সমস্যা নেই। আলাদা ফিক্সের বিষয়, এখানে শুধু এড়িয়ে
    // যাওয়া হলো।
    ধরি ফল = লেখা.স্লাইস(স, i, ১)
    রিটার্ন ফল
}

ফাংশন জেসন_এগোও(শেয়ার সংখ্যা কার্সার, সংখ্যা n) -> ফাঁকা {
    বসাও(কার্সার, মান(কার্সার) + n)
}

ফাংশন জেসন_হোয়াইটস্পেস_বাদ(লেখা স, শেয়ার সংখ্যা কার্সার) -> ফাঁকা {
    যতক্ষণ (মান(কার্সার) < দৈর্ঘ্য(স)) {
        ধরি চ = জেসন_বর্তমান(স, কার্সার)
        যদি (চ == " " অথবা চ == "\t" অথবা চ == "\n" অথবা চ == "\r") {
            জেসন_এগোও(কার্সার, ১)
        } নাহলে {
            বিরতি
        }
    }
}

ফাংশন জেসন_অঙ্ক_কি(লেখা চ) -> বুলিয়ান {
    রিটার্ন দৈর্ঘ্য(চ) == ১ এবং লেখা.ধারণ_করে("０১২৩৪৫৬৭৮৯0123456789", চ)
}

ফাংশন জেসন_পার্স_স্ট্রিং(লেখা স, শেয়ার সংখ্যা কার্সার) -> লেখা {
    জেসন_এগোও(কার্সার, ১)
    ধরি ফলাফল = ""
    ধরি শেষ = মিথ্যা
    যতক্ষণ (শেষ == মিথ্যা এবং মান(কার্সার) < দৈর্ঘ্য(স)) {
        ধরি চ = জেসন_বর্তমান(স, কার্সার)
        যদি (চ == "\"") {
            জেসন_এগোও(কার্সার, ১)
            শেষ = সত্য
        } নাহলে {
            যদি (চ == "\\") {
                জেসন_এগোও(কার্সার, ১)
                ধরি পরের = জেসন_বর্তমান(স, কার্সার)
                যদি (পরের == "n") {
                    ফলাফল = ফলাফল + "\n"
                } নাহলে {
                    যদি (পরের == "t") {
                        ফলাফল = ফলাফল + "\t"
                    } নাহলে {
                        যদি (পরের == "r") {
                            ফলাফল = ফলাফল + "\r"
                        } নাহলে {
                            ফলাফল = ফলাফল + পরের
                        }
                    }
                }
                জেসন_এগোও(কার্সার, ১)
            } নাহলে {
                ফলাফল = ফলাফল + চ
                জেসন_এগোও(কার্সার, ১)
            }
        }
    }
    রিটার্ন ফলাফল
}

ফাংশন জেসন_পার্স_সংখ্যা(লেখা স, শেয়ার সংখ্যা কার্সার) -> জেসন_মান {
    ধরি শুরু = মান(কার্সার)
    যদি (জেসন_বর্তমান(স, কার্সার) == "-") {
        জেসন_এগোও(কার্সার, ১)
    }
    যতক্ষণ (জেসন_অঙ্ক_কি(জেসন_বর্তমান(স, কার্সার))) {
        জেসন_এগোও(কার্সার, ১)
    }
    যদি (জেসন_বর্তমান(স, কার্সার) == ".") {
        জেসন_এগোও(কার্সার, ১)
        যতক্ষণ (জেসন_অঙ্ক_কি(জেসন_বর্তমান(স, কার্সার))) {
            জেসন_এগোও(কার্সার, ১)
        }
    }
    যদি (জেসন_বর্তমান(স, কার্সার) == "e" অথবা জেসন_বর্তমান(স, কার্সার) == "E") {
        জেসন_এগোও(কার্সার, ১)
        যদি (জেসন_বর্তমান(স, কার্সার) == "+" অথবা জেসন_বর্তমান(স, কার্সার) == "-") {
            জেসন_এগোও(কার্সার, ১)
        }
        যতক্ষণ (জেসন_অঙ্ক_কি(জেসন_বর্তমান(স, কার্সার))) {
            জেসন_এগোও(কার্সার, ১)
        }
    }
    ধরি কাঁচা = লেখা.স্লাইস(স, শুরু, মান(কার্সার) - শুরু)
    রিটার্ন জেসন_সংখ্যা(দশমিকে(কাঁচা))
}

ফাংশন জেসন_পার্স_তালিকা_উপাদান(লেখা স, শেয়ার সংখ্যা কার্সার) -> জেসন_মান[] {
    ধরি প্রথম = জেসন_পার্স_মান(স, কার্সার)
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    যদি (জেসন_বর্তমান(স, কার্সার) == ",") {
        জেসন_এগোও(কার্সার, ১)
        জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
        ধরি বাকি = জেসন_পার্স_তালিকা_উপাদান(স, কার্সার)
        রিটার্ন [প্রথম] + বাকি
    }
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    জেসন_এগোও(কার্সার, ১)
    রিটার্ন [প্রথম]
}

ফাংশন জেসন_পার্স_তালিকা_ভ্যাল(লেখা স, শেয়ার সংখ্যা কার্সার) -> জেসন_মান {
    জেসন_এগোও(কার্সার, ১)
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    যদি (জেসন_বর্তমান(স, কার্সার) == "]") {
        জেসন_এগোও(কার্সার, ১)
        রিটার্ন জেসন_তালিকা(জেসন_খালি_তালিকা())
    }
    ধরি উপাদান = জেসন_পার্স_তালিকা_উপাদান(স, কার্সার)
    রিটার্ন জেসন_তালিকা(উপাদান)
}

ফাংশন জেসন_পার্স_বস্তু_ভ্যাল(লেখা স, শেয়ার সংখ্যা কার্সার) -> জেসন_মান {
    জেসন_এগোও(কার্সার, ১)
    ধরি ফলাফল: ম্যাপ[লেখা, জেসন_মান] = ম্যাপ_তৈরি()
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    যদি (জেসন_বর্তমান(স, কার্সার) == "}") {
        জেসন_এগোও(কার্সার, ১)
        রিটার্ন জেসন_বস্তু(ফলাফল)
    }
    ধরি সক্রিয় = সত্য
    যতক্ষণ (সক্রিয়) {
        জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
        ধরি কী = জেসন_পার্স_স্ট্রিং(স, কার্সার)
        জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
        জেসন_এগোও(কার্সার, ১)
        জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
        ধরি মানটা = জেসন_পার্স_মান(স, কার্সার)
        ফলাফল[কী] = মানটা
        জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
        যদি (জেসন_বর্তমান(স, কার্সার) == ",") {
            জেসন_এগোও(কার্সার, ১)
        } নাহলে {
            সক্রিয় = মিথ্যা
        }
    }
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    জেসন_এগোও(কার্সার, ১)
    রিটার্ন জেসন_বস্তু(ফলাফল)
}

ফাংশন জেসন_পার্স_মান(লেখা স, শেয়ার সংখ্যা কার্সার) -> জেসন_মান {
    জেসন_হোয়াইটস্পেস_বাদ(স, কার্সার)
    ধরি চ = জেসন_বর্তমান(স, কার্সার)

    যদি (চ == "{") {
        রিটার্ন জেসন_পার্স_বস্তু_ভ্যাল(স, কার্সার)
    }
    যদি (চ == "[") {
        রিটার্ন জেসন_পার্স_তালিকা_ভ্যাল(স, কার্সার)
    }
    যদি (চ == "\"") {
        রিটার্ন জেসন_লেখা(জেসন_পার্স_স্ট্রিং(স, কার্সার))
    }
    যদি (চ == "t") {
        জেসন_এগোও(কার্সার, ৪)
        রিটার্ন জেসন_বুল(সত্য)
    }
    যদি (চ == "f") {
        জেসন_এগোও(কার্সার, ৫)
        রিটার্ন জেসন_বুল(মিথ্যা)
    }
    যদি (চ == "n") {
        জেসন_এগোও(কার্সার, ৪)
        রিটার্ন জেসন_নাল()
    }
    যদি (চ == "-" অথবা জেসন_অঙ্ক_কি(চ)) {
        রিটার্ন জেসন_পার্স_সংখ্যা(স, কার্সার)
    }
    রিটার্ন জেসন_ত্রুটি("অপ্রত্যাশিত অক্ষর")
}

ফাংশন জেসন_পার্স(লেখা স) -> জেসন_মান {
    ধরি কার্সার = শেয়ার_করো(০)
    রিটার্ন জেসন_পার্স_মান(স, কার্সার)
}

// ---- সিরিয়ালাইজার ----

ফাংশন জেসন_পালাও(লেখা স) -> লেখা {
    ধরি ফলাফল = "\""
    ধরি i = ০
    যতক্ষণ (i < দৈর্ঘ্য(স)) {
        ধরি চ = লেখা.স্লাইস(স, i, ১)
        যদি (চ == "\"") {
            ফলাফল = ফলাফল + "\\\""
        } নাহলে {
            যদি (চ == "\\") {
                ফলাফল = ফলাফল + "\\\\"
            } নাহলে {
                যদি (চ == "\n") {
                    ফলাফল = ফলাফল + "\\n"
                } নাহলে {
                    যদি (চ == "\t") {
                        ফলাফল = ফলাফল + "\\t"
                    } নাহলে {
                        যদি (চ == "\r") {
                            ফলাফল = ফলাফল + "\\r"
                        } নাহলে {
                            ফলাফল = ফলাফল + চ
                        }
                    }
                }
            }
        }
        i = i + ১
    }
    রিটার্ন ফলাফল + "\""
}

ফাংশন জেসন_তালিকা_লেখো(জেসন_মান[] ত) -> লেখা {
    ধরি ফলাফল = "["
    ধরি i = ০
    যতক্ষণ (i < দৈর্ঘ্য(ত)) {
        যদি (i > ০) {
            ফলাফল = ফলাফল + ","
        }
        ফলাফল = ফলাফল + জেসন_লেখো(ত[i])
        i = i + ১
    }
    রিটার্ন ফলাফল + "]"
}

ফাংশন জেসন_বস্তু_লেখো(ম্যাপ[লেখা, জেসন_মান] ব) -> লেখা {
    ধরি কীগুলো = চাবি_গুলো(ব)
    ধরি ফলাফল = "{"
    ধরি i = ০
    যতক্ষণ (i < দৈর্ঘ্য(কীগুলো)) {
        যদি (i > ০) {
            ফলাফল = ফলাফল + ","
        }
        ধরি কী = কীগুলো[i]
        ফলাফল = ফলাফল + জেসন_পালাও(কী) + ":" + জেসন_লেখো(ব[কী])
        i = i + ১
    }
    রিটার্ন ফলাফল + "}"
}

ফাংশন জেসন_লেখো(জেসন_মান ভ) -> লেখা {
    যদি (জেসন_নাল_কি(ভ)) {
        রিটার্ন "null"
    }
    যদি (জেসন_বুল_কি(ভ)) {
        যদি (ভ.বুলিয়ান_মান) {
            রিটার্ন "true"
        }
        রিটার্ন "false"
    }
    যদি (জেসন_সংখ্যা_কি(ভ)) {
        রিটার্ন লেখায়(ভ.সংখ্যা_মান)
    }
    যদি (জেসন_লেখা_কি(ভ)) {
        রিটার্ন জেসন_পালাও(ভ.লেখা_মান)
    }
    যদি (জেসন_তালিকা_কি(ভ)) {
        রিটার্ন জেসন_তালিকা_লেখো(ভ.তালিকা_মান)
    }
    যদি (জেসন_বস্তু_কি(ভ)) {
        রিটার্ন জেসন_বস্তু_লেখো(ভ.বস্তু_মান)
    }
    রিটার্ন "null"
}
