ফাংশন বানাও(সংখ্যা n) -> লেখা {
    রিটার্ন "আইটেম-" + লেখায়(n)
}

অ্যাপ {
    ধরি v: সংখ্যা[] = []
    যোগ_করো(v, ১০)
    যোগ_করো(v, ২০)
    যোগ_করো(v, ৩০)
    লেখো(লেখায়(দৈর্ঘ্য(v)))
    লেখো(লেখায়(v[০]))
    লেখো(লেখায়(v[২]))

    ধরি স: লেখা[] = []
    ধরি i = ০
    যতক্ষণ (i < ৫০) {
        যোগ_করো(স, বানাও(i))
        i = i + ১
    }
    লেখো(লেখায়(দৈর্ঘ্য(স)))
    লেখো(স[০])
    লেখো(স[৪৯])
}
