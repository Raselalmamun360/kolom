অ্যাপ {

    লেখো(সংখ্যায়("78") + 1)
    লেখো(সংখ্যায়("৯২"))
    লেখো(সংখ্যায়("-5"))
    লেখো(দশমিকে("3.5") * 2.0)
    লেখো(দশমিকে("২.৫"))

    চেষ্টা {
        লেখো(সংখ্যায়("hello"))
    } ধরো (e) {
        লেখো("ধরা: সংখ্যা নয়")
    }

    চেষ্টা {
        লেখো(দশমিকে("abc"))
    } ধরো (e) {
        লেখো("ধরা: দশমিক নয়")
    }

}
