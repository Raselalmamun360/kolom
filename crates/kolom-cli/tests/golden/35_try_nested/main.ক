ইম্পোর্ট ফাইল

// রিটার্ন চেষ্টা-র ভিতর থেকে — দুই পথেই ব্লকটি বন্ধ হওয়া চাই
ফাংশন নিরাপদ_পড়ো(লেখা পথ) -> লেখা {

    চেষ্টা {

        রিটার্ন ফাইল.পড়ো(পথ)

    } ধরো(ত) {

        রিটার্ন "ডিফল্ট"

    }

}

অ্যাপ {

    লেখো(নিরাপদ_পড়ো("নেই_এমন_ফাইল.txt"))

    // নেস্টেড — ভিতরের ব্লক ধরবে, বাইরেরটা নয়
    চেষ্টা {

        চেষ্টা {

            ধরি ক = ৫ / ০

            লেখো("এখানে আসার কথা নয়")

        } ধরো(ত) {

            লেখো("ভিতরে ধরা")

        }

        লেখো("বাইরের বাকি অংশ")

    } ধরো(ত) {

        লেখো("বাইরে ধরা — আসার কথা নয়")

    }

    // লুপের ভিতরে চেষ্টা, আর সেখান থেকে বিরতি
    ধরি গণনা = ০

    লুপ (৫) {

        চেষ্টা {

            গণনা = গণনা + ১

            যদি (গণনা == ৩) {

                বিরতি

            }

        } ধরো(ত) {

            লেখো("ধরা")

        }

    }

    লেখো(লেখায়(গণনা))

    // বিরতি দিয়ে বেরোনোর পরেও চেষ্টা কাজ করে
    চেষ্টা {

        ধরি খ = ১ / ০

        লেখো("এখানেও আসার কথা নয়")

    } ধরো(ত) {

        লেখো("শেষ ধরা")

    }

}
