// `কোডে`/`অক্ষরে` — `অক্ষর` আর তার ইউনিকোড স্কেলার ভ্যালুর মধ্যে
// রূপান্তর। এই জোড়াটা ছাড়া কলমে কোডপয়েন্ট নিয়ে কোনো কাজ করা যেত না,
// আর সেলফ-হোস্টেড লেক্সারের `\u{...}` এস্কেপ ডিকোড করতে দুটোই লাগে।

ফাংশন হেক্সের_মান(অক্ষর c) -> সংখ্যা {
    যদি (c >= '0' এবং c <= '9') { রিটার্ন কোডে(c) - কোডে('0') }
    যদি (c >= 'a' এবং c <= 'f') { রিটার্ন কোডে(c) - কোডে('a') + ১০ }
    রিটার্ন কোডে(c) - কোডে('A') + ১০
}

ফাংশন হেক্স_থেকে_অক্ষর(লেখা h) -> অক্ষর {
    ধরি মান = ০
    ধরি i = ০
    যতক্ষণ (i < দৈর্ঘ্য(h)) {
        মান = মান * ১৬ + হেক্সের_মান(h[i])
        i = i + ১
    }
    রিটার্ন অক্ষরে(মান)
}

অ্যাপ {
    লেখো(লেখায়(কোডে('ক')))
    লেখো(লেখায়(কোডে('A')))
    লেখো(লেখায়(অক্ষরে(২৪৫৩)))
    লেখো(লেখায়(অক্ষরে(কোডে('হ'))))

    // রাউন্ড-ট্রিপ, আর হেক্স ডিকোডিং — লেক্সারের আসল ব্যবহার
    লেখো(লেখায়(হেক্স_থেকে_অক্ষর("0995")))
    লেখো(লেখায়(হেক্স_থেকে_অক্ষর("09B2")))

    // সীমার বাইরে ও সারোগেট — রানটাইম ত্রুটি, ধরা যায়
    চেষ্টা {
        লেখো(লেখায়(অক্ষরে(১১১৪১১২)))
    } ধরো (e) {
        লেখো("ধরা পড়েছে")
    }
}
