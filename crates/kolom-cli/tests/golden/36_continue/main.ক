অ্যাপ {

    // চলবে — এই ধাপটুকু বাদ দিয়ে পরেরটায় যাও
    ধরি ক = ০

    যতক্ষণ (ক < ৬) {

        ক = ক + ১

        যদি ((ক % ২) == ০) {

            চলবে

        }

        লেখো(লেখায়(ক))

    }

    // গণনা-লুপেও একই আচরণ
    ধরি যোগফল = ০

    লুপ (৫) {

        যোগফল = যোগফল + ১

        যদি (যোগফল == ২) {

            চলবে

        }

        লেখো("ধাপ")

    }

    // বিরতি আর চলবে একসাথে
    ধরি সংখ্যাগুলো = [১, ২, ৩, ৪, ৫]

    প্রতি (স : সংখ্যাগুলো) {

        যদি (স == ২) {

            চলবে

        }

        যদি (স == ৪) {

            বিরতি

        }

        লেখো(লেখায়(স))

    }

}
