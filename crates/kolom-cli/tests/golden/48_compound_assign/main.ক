তথ্য পয়েন্ট {
    x: সংখ্যা
}

অ্যাপ {

    // প্লেইন ভ্যারিয়েবলে সব চারটা কম্পাউন্ড অপারেটর
    ধরি ক = ১০
    ক += ৫
    লেখো(লেখায়(ক))
    ক -= ৩
    লেখো(লেখায়(ক))
    ক *= ২
    লেখো(লেখায়(ক))
    ক /= ৪
    লেখো(লেখায়(ক))

    // অ্যারে ইনডেক্সে
    ধরি তালিকা = [১, ২, ৩]
    তালিকা[০] += ৫
    লেখো(লেখায়(তালিকা[০]))

    // স্ট্রাক্ট ফিল্ডে
    ধরি p = পয়েন্ট(১)
    p.x += ৫
    লেখো(লেখায়(p.x))

}
