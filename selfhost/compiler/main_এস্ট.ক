ফাংশন এস্কেপ(লেখা s) -> লেখা {
    ধরি out = ""
    ধরি i = ০
    যতক্ষণ (i < দৈর্ঘ্য(s)) {
        ধরি c = s[i]
        ধরি code = কোডে(c)
        যদি (code == ৯২) {
            out = out + "\\\\"
        } নাহলে {
            যদি (code == ৯) {
                out = out + "\\t"
            } নাহলে {
                যদি (code == ১০) {
                    out = out + "\\n"
                } নাহলে {
                    যদি (code == ১৩) {
                        out = out + "\\r"
                    } নাহলে {
                        যদি (code < ৩২ অথবা code == ১২৭) {
                            out = out + "\\u{" + লেখায়(code) + "}"
                        } নাহলে {
                            out = out + লেখায়(c)
                        }
                    }
                }
            }
        }
        i = i + ১
    }
    রিটার্ন out
}

ফাংশন রেকর্ড(লেখা out, লেখা kind, সংখ্যা লাইন, সংখ্যা কলাম, লেখা payload) -> লেখা {
    রিটার্ন out + "NODE\t" + kind + "\t" + লেখায়(লাইন) + "\t" + লেখায়(কলাম) + "\t" + এস্কেপ(payload) + "\n"
}

ফাংশন শুরু(লেখা out, লেখা kind, সংখ্যা লাইন, সংখ্যা কলাম) -> লেখা {
    রিটার্ন রেকর্ড(out, "begin_" + kind, লাইন, কলাম, "")
}

ফাংশন শেষ(লেখা out, লেখা kind) -> লেখা {
    রিটার্ন রেকর্ড(out, "end_" + kind, ০, ০, "")
}

ফাংশন আইডি_ডাম্প(লেখা out, আইডি id) -> লেখা {
    রিটার্ন রেকর্ড(out, "ident", id.পজ.লাইন, id.পজ.কলাম, id.নাম)
}

ফাংশন টাইপ_ডাম্প(লেখা out, টাইপ_এক্সপ্র ty) -> লেখা {
    রিটার্ন মিলাও ty {
        নাম_টে(id) => আইডি_ডাম্প(রেকর্ড(out, "type_named", id.পজ.লাইন, id.পজ.কলাম, ""), id),
        অ্যারে_টে(inner) => শেষ(টাইপ_ডাম্প(শুরু(out, "type_array", ০, ০), খুলুন_বি(inner, নাম_টে(আইডি("ত্রুটি", পজ(০, ০))))), "type_array"),
        শেয়ার_টে(inner) => শেষ(টাইপ_ডাম্প(শুরু(out, "type_shared", ০, ০), খুলুন_বি(inner, নাম_টে(আইডি("ত্রুটি", পজ(০, ০))))), "type_shared"),
        ম্যাপ_টে(key, value) => শেষ(টাইপ_ডাম্প(টাইপ_ডাম্প(শুরু(out, "type_map", ০, ০), খুলুন_বি(key, নাম_টে(আইডি("ত্রুটি", পজ(০, ০))))), খুলুন_বি(value, নাম_টে(আইডি("ত্রুটি", পজ(০, ০))))), "type_map"),
        ফাংশন_টে(params, ret) => শেষ(টাইপ_ডাম্প_তালিকা(টাইপ_ডাম্প_তালিকা(শুরু(out, "type_func", ০, ০), params), [ret]), "type_func"),
        জেনেরিক_টে(id, args) => শেষ(টাইপ_ডাম্প_তালিকা(আইডি_ডাম্প(শুরু(out, "type_generic", id.পজ.লাইন, id.পজ.কলাম), id), args), "type_generic")
    }
}

ফাংশন টাইপ_ডাম্প_তালিকা(লেখা out, টাইপ_এক্সপ্র[] values) -> লেখা {
    ধরি r = out
    প্রতি (value : values) { r = টাইপ_ডাম্প(r, value) }
    রিটার্ন r
}

ফাংশন ব্লক_ডাম্প(লেখা out, ব্লক b) -> লেখা {
    ধরি r = শুরু(out, "block", ০, ০)
    প্রতি (s : b.স্টেটগুলো) { r = স্টেট_ডাম্প(r, s) }
    রিটার্ন শেষ(r, "block")
}

ফাংশন লিট_ডাম্প(লেখা out, লিট value) -> লেখা {
    রিটার্ন মিলাও value {
        ইন্ট_লি(v) => রেকর্ড(out, "lit_int", ০, ০, লেখায়(v)),
        ফ্লোট_লি(v) => রেকর্ড(out, "lit_float", ০, ০, লেখায়(v)),
        স্ট্র_লি(v) => রেকর্ড(out, "lit_str", ০, ০, v),
        চার_লি(v) => রেকর্ড(out, "lit_char", ০, ০, লেখায়(v)),
        বুল_লি(v) => রেকর্ড(out, "lit_bool", ০, ০, লেখায়(v)),
        নাল_লি => রেকর্ড(out, "lit_null", ০, ০, ""),
        অ্যারে_লি(values) => শেষ(এক্সপ্র_ডাম্প_তালিকা(শুরু(out, "lit_array", ০, ০), values), "lit_array")
    }
}

ফাংশন এক্সপ্র_ডাম্প_তালিকা(লেখা out, এক্সপ্র[] values) -> লেখা {
    ধরি r = out
    প্রতি (value : values) { r = এক্সপ্র_ডাম্প(r, value) }
    রিটার্ন r
}

ফাংশন অপ_নাম(বাইনারি_অপ op) -> লেখা {
    রিটার্ন মিলাও op {
        যোগ_বা => "add", বিয়োগ_বা => "sub", গুণ_বা => "mul", ভাগ_বা => "div", ভাগশেষ_বা => "mod",
        সমান_বা => "eq", অসমান_বা => "neq", ছোট_বা => "lt", বড়_বা => "gt", ছোটসম_বা => "le",
        বড়সম_বা => "ge", এবং_বা => "and", অথবা_বা => "or"
    }
}

ফাংশন এক্সপ্র_ডাম্প(লেখা out, এক্সপ্র e) -> লেখা {
    ধরি p = e.পজ
    রিটার্ন মিলাও e.ধরন {
        লিট_এক(v) => শেষ(লিট_ডাম্প(শুরু(out, "expr_lit", p.লাইন, p.কলাম), v), "expr_lit"),
        আইডি_এক(id) => শেষ(আইডি_ডাম্প(শুরু(out, "expr_ident", p.লাইন, p.কলাম), id), "expr_ident"),
        কোয়ালিফাইড_এক(module, name) => শেষ(আইডি_ডাম্প(আইডি_ডাম্প(শুরু(out, "expr_qualified", p.লাইন, p.কলাম), module), name), "expr_qualified"),
        ইউনারি_এক(op, inner) => শেষ(এক্সপ্র_ডাম্প(রেকর্ড(শুরু(out, "expr_unary", p.লাইন, p.কলাম), "operator", p.লাইন, p.কলাম, মিলাও op { নেগ_ইউ => "neg", নট_ইউ => "not" }), খুলুন_বি(inner, এক্সপ্র(লিট_এক(নাল_লি), p))), "expr_unary"),
        পোস্টফিক্স_এক(inner, suffixes) => শেষ(এক্সপ্র_ডাম্প_সাফিক্স(এক্সপ্র_ডাম্প(শুরু(out, "expr_postfix", p.লাইন, p.কলাম), খুলুন_বি(inner, এক্সপ্র(লিট_এক(নাল_লি), p))), suffixes), "expr_postfix"),
        বাইনারি_এক(op, left, right) => শেষ(এক্সপ্র_ডাম্প(এক্সপ্র_ডাম্প(রেকর্ড(শুরু(out, "expr_binary", p.লাইন, p.কলাম), "operator", p.লাইন, p.কলাম, অপ_নাম(op)), খুলুন_বি(left, এক্সপ্র(লিট_এক(নাল_লি), p))), খুলুন_বি(right, এক্সপ্র(লিট_এক(নাল_লি), p))), "expr_binary"),
        অ্যাসাইন_এক(target, rhs) => শেষ(এক্সপ্র_ডাম্প(এলভ্যালু_ডাম্প(শুরু(out, "expr_assign", p.লাইন, p.কলাম), target), খুলুন_বি(rhs, এক্সপ্র(লিট_এক(নাল_লি), p))), "expr_assign"),
        ফিল্ডঅ্যাসাইন_এক(base, field, rhs) => শেষ(এক্সপ্র_ডাম্প(আইডি_ডাম্প(আইডি_ডাম্প(শুরু(out, "expr_field_assign", p.লাইন, p.কলাম), base), field), খুলুন_বি(rhs, এক্সপ্র(লিট_এক(নাল_লি), p))), "expr_field_assign"),
        ম্যাচ_এক(value) => ম্যাচ_ডাম্প(out, value)
    }
}

ফাংশন এলভ্যালু_ডাম্প(লেখা out, এলভ্যালু value) -> লেখা {
    ধরি r = আইডি_ডাম্প(শুরু(out, "lvalue", value.বেস.পজ.লাইন, value.বেস.পজ.কলাম), value.বেস)
    প্রতি (index : value.ইনডেক্স) { r = এক্সপ্র_ডাম্প(r, index) }
    যদি (আছে_বি(value.ফিল্ড)) { r = আইডি_ডাম্প(r, খুলুন_বি(value.ফিল্ড, value.বেস)) }
    রিটার্ন শেষ(r, "lvalue")
}

ফাংশন এক্সপ্র_ডাম্প_সাফিক্স(লেখা out, সাফিক্স[] values) -> লেখা {
    ধরি r = out
    প্রতি (suffix : values) {
        ধরি p = পজ(০, ০)
        ধরি next = মিলাও suffix {
            কল_সাফ(args, pos) => শেষ(এক্সপ্র_ডাম্প_তালিকা(শুরু(r, "suffix_call", pos.লাইন, pos.কলাম), args), "suffix_call"),
            ইনডেক্স_সাফ(index, pos) => শেষ(এক্সপ্র_ডাম্প(শুরু(r, "suffix_index", pos.লাইন, pos.কলাম), খুলুন_বি(index, এক্সপ্র(লিট_এক(নাল_লি), p))), "suffix_index"),
            ফিল্ড_সাফ(id) => শেষ(আইডি_ডাম্প(শুরু(r, "suffix_field", id.পজ.লাইন, id.পজ.কলাম), id), "suffix_field")
        }
        r = next
    }
    রিটার্ন r
}

ফাংশন প্যাটার্ন_ডাম্প(লেখা out, প্যাটার্ন value) -> লেখা {
    রিটার্ন মিলাও value {
        ওয়াইল্ডকার্ড_প্যা(pos) => রেকর্ড(out, "pattern_wildcard", pos.লাইন, pos.কলাম, ""),
        ভ্যারিয়েন্ট_প্যা(name, binds, pos) => শেষ(আইডি_ডাম্প_তালিকা(আইডি_ডাম্প(শুরু(out, "pattern_variant", pos.লাইন, pos.কলাম), name), binds), "pattern_variant")
    }
}

ফাংশন আইডি_ডাম্প_তালিকা(লেখা out, আইডি[] values) -> লেখা {
    ধরি r = out
    প্রতি (value : values) { r = আইডি_ডাম্প(r, value) }
    রিটার্ন r
}

ফাংশন ম্যাচ_ডাম্প(লেখা out, ম্যাচ_এক্সপ্র value) -> লেখা {
    ধরি r = এক্সপ্র_ডাম্প(শুরু(out, "expr_match", value.পজ.লাইন, value.পজ.কলাম), খুলুন_বি(value.স্ক্রুটিনি, এক্সপ্র(লিট_এক(নাল_লি), value.পজ)))
    প্রতি (arm : value.আর্মগুলো) {
        r = প্যাটার্ন_ডাম্প(r, arm.প্যাটার্ন)
        r = এক্সপ্র_ডাম্প(r, arm.বডি)
    }
    রিটার্ন শেষ(r, "expr_match")
}

ফাংশন স্টেট_ডাম্প(লেখা out, স্টেট s) -> লেখা {
    রিটার্ন মিলাও s {
        ভ্যার_স্ট(v) => শেষ(এক্সপ্র_ডাম্প(যদি_টাইপ_ডাম্প(আইডি_ডাম্প(শুরু(out, "stmt_var", v.নাম.পজ.লাইন, v.নাম.পজ.কলাম), v.নাম), v.ধরন), v.শুরুর_মান), "stmt_var"),
        ধ্রুবক_স্ট(v) => শেষ(এক্সপ্র_ডাম্প(টাইপ_ডাম্প(আইডি_ডাম্প(শুরু(out, "stmt_const", v.নাম.পজ.লাইন, v.নাম.পজ.কলাম), v.নাম), v.ধরন), v.শুরুর_মান), "stmt_const"),
        ইফ_স্ট(v) => ইফ_ডাম্প(out, v),
        লুপ_স্ট(v) => শেষ(ব্লক_ডাম্প(এক্সপ্র_ডাম্প(শুরু(out, "stmt_loop", v.পজ.লাইন, v.পজ.কলাম), v.গণনা), v.বডি), "stmt_loop"),
        হোয়াইল_স্ট(v) => শেষ(ব্লক_ডাম্প(এক্সপ্র_ডাম্প(শুরু(out, "stmt_while", v.পজ.লাইন, v.পজ.কলাম), v.শর্ত), v.বডি), "stmt_while"),
        ফরইচ_স্ট(v) => শেষ(ব্লক_ডাম্প(এক্সপ্র_ডাম্প(আইডি_ডাম্প(শুরু(out, "stmt_foreach", v.পজ.লাইন, v.পজ.কলাম), v.ভ্যার), v.ইটার), v.বডি), "stmt_foreach"),
        রিটার্ন_স্ট(v) => শেষ(ঐচ্ছিক_এক্সপ্র_ডাম্প(শুরু(out, "stmt_return", v.পজ.লাইন, v.পজ.কলাম), v.মান), "stmt_return"),
        ব্রেক_স্ট(pos) => রেকর্ড(out, "stmt_break", pos.লাইন, pos.কলাম, ""),
        কন্টিনিউ_স্ট(pos) => রেকর্ড(out, "stmt_continue", pos.লাইন, pos.কলাম, ""),
        এক্সপ্র_স্ট(e) => শেষ(এক্সপ্র_ডাম্প(শুরু(out, "stmt_expr", e.পজ.লাইন, e.পজ.কলাম), e), "stmt_expr"),
        নেস্টেড_স্ট(b) => শেষ(ব্লক_ডাম্প(শুরু(out, "stmt_nested", ০, ০), b), "stmt_nested"),
        চেষ্টা_স্ট(v) => শেষ(ব্লক_ডাম্প(আইডি_ডাম্প(ব্লক_ডাম্প(শুরু(out, "stmt_try", v.এরর_ভ্যার.পজ.লাইন, v.এরর_ভ্যার.পজ.কলাম), v.বডি), v.এরর_ভ্যার), v.হ্যান্ডলার), "stmt_try"),
        উইজেট_স্ট(v) => শেষ(উইজেট_ডাম্প(out, v), "stmt_widget"),
        ডিসপ্লে_স্ট(b) => শেষ(ব্লক_ডাম্প(শুরু(out, "stmt_display", ০, ০), b), "stmt_display")
    }
}

ফাংশন যদি_টাইপ_ডাম্প(লেখা out, বিকল্প<টাইপ_এক্সপ্র> value) -> লেখা {
    যদি (আছে_বি(value)) { রিটার্ন টাইপ_ডাম্প(out, খুলুন_বি(value, নাম_টে(আইডি("ত্রুটি", পজ(০, ০))))) }
    রিটার্ন out
}

ফাংশন ঐচ্ছিক_এক্সপ্র_ডাম্প(লেখা out, বিকল্প<এক্সপ্র> value) -> লেখা {
    যদি (আছে_বি(value)) { রিটার্ন এক্সপ্র_ডাম্প(out, খুলুন_বি(value, এক্সপ্র(লিট_এক(নাল_লি), পজ(০, ০)))) }
    রিটার্ন out
}

ফাংশন ইফ_ডাম্প(লেখা out, ইফ_স্ট্যাট value) -> লেখা {
    ধরি r = ব্লক_ডাম্প(এক্সপ্র_ডাম্প(শুরু(out, "stmt_if", value.পজ.লাইন, value.পজ.কলাম), value.শর্ত), value.তাহলে)
    যদি (আছে_বি(value.এলস)) {
        ধরি branch = খুলুন_বি(value.এলস, ব্লক_এল(ব্লক([])))
        r = মিলাও branch { ইফ_এল(v) => ইফ_ডাম্প(r, খুলুন_বি(v, value)), ব্লক_এল(b) => ব্লক_ডাম্প(r, b) }
    }
    রিটার্ন শেষ(r, "stmt_if")
}

ফাংশন উইজেট_ডাম্প(লেখা out, উইজেট_নোড value) -> লেখা {
    ধরি r = রেকর্ড(শুরু(out, "stmt_widget", value.পজ.লাইন, value.পজ.কলাম), "widget_name", value.পজ.লাইন, value.পজ.কলাম, value.কীওয়ার্ড)
    ধরি a = এক্সপ্র_ডাম্প_তালিকা(r, value.আর্গগুলো)
    ধরি b = a
    যদি (আছে_বি(value.বডি)) {
        b = ব্লক_ডাম্প(a, খুলুন_বি(value.বডি, ব্লক([])))
    }
    রিটার্ন শেষ(b, "stmt_widget")
}

ফাংশন ডাম্প(প্রোগ্রাম prog) -> লেখা {
    ধরি r = শুরু("", "program", ০, ০)
    প্রতি (id : prog.ইম্পোর্টগুলো) { r = আইডি_ডাম্প(r, id) }
    প্রতি (decl : prog.স্ট্রাক্টগুলো) {
        r = শুরু(r, "struct", decl.নাম.পজ.লাইন, decl.নাম.পজ.কলাম)
        r = আইডি_ডাম্প(r, decl.নাম)
        প্রতি (param : decl.টাইপপ্যারাম) { r = আইডি_ডাম্প(r, param) }
        প্রতি (field : decl.ফিল্ডগুলো) {
            r = আইডি_ডাম্প(r, field.নাম)
            r = টাইপ_ডাম্প(r, field.ধরন)
        }
        r = শেষ(r, "struct")
    }
    প্রতি (decl : prog.এনামগুলো) {
        r = শুরু(r, "enum", decl.নাম.পজ.লাইন, decl.নাম.পজ.কলাম)
        r = আইডি_ডাম্প(r, decl.নাম)
        প্রতি (param : decl.টাইপপ্যারাম) { r = আইডি_ডাম্প(r, param) }
        প্রতি (variant : decl.ভ্যারিয়েন্টগুলো) {
            r = শুরু(r, "variant", variant.নাম.পজ.লাইন, variant.নাম.পজ.কলাম)
            r = আইডি_ডাম্প(r, variant.নাম)
            প্রতি (payload : variant.পেলোড) { r = টাইপ_ডাম্প(r, payload) }
            r = শেষ(r, "variant")
        }
        r = শেষ(r, "enum")
    }
    প্রতি (f : prog.ফাংশনগুলো) {
        r = শুরু(r, "function", f.নাম.পজ.লাইন, f.নাম.পজ.কলাম)
        r = আইডি_ডাম্প(r, f.নাম)
        প্রতি (param : f.টাইপপ্যারাম) { r = আইডি_ডাম্প(r, param) }
        প্রতি (param : f.প্যারামগুলো) {
            r = টাইপ_ডাম্প(r, param.ধরন)
            r = আইডি_ডাম্প(r, param.নাম)
        }
        r = টাইপ_ডাম্প(r, f.রিটার্নটাইপ)
        r = ব্লক_ডাম্প(r, f.বডি)
        r = শেষ(r, "function")
    }
    প্রতি (ext : prog.এক্সটার্নগুলো) {
        r = শুরু(r, "extern", ext.পজ.লাইন, ext.পজ.কলাম)
        r = রেকর্ড(r, "abi", ext.পজ.লাইন, ext.পজ.কলাম, ext.এবিআই)
        প্রতি (f : ext.ফাংশনগুলো) {
            r = শুরু(r, "extern_function", f.নাম.পজ.লাইন, f.নাম.পজ.কলাম)
            r = আইডি_ডাম্প(r, f.নাম)
            প্রতি (param : f.প্যারামগুলো) {
                r = টাইপ_ডাম্প(r, param.ধরন)
                r = আইডি_ডাম্প(r, param.নাম)
            }
            r = টাইপ_ডাম্প(r, f.রিটার্নটাইপ)
            r = শেষ(r, "extern_function")
        }
        r = শেষ(r, "extern")
    }
    প্রতি (decl : prog.ধ্রুবকগুলো) {
        r = শুরু(r, "const", decl.নাম.পজ.লাইন, decl.নাম.পজ.কলাম)
        r = আইডি_ডাম্প(r, decl.নাম)
        r = টাইপ_ডাম্প(r, decl.ধরন)
        r = এক্সপ্র_ডাম্প(r, decl.শুরুর_মান)
        r = শেষ(r, "const")
    }
    যদি (আছে_বি(prog.অ্যাপ_ঘোষণা)) {
        ধরি app = খুলুন_বি(prog.অ্যাপ_ঘোষণা, অ্যাপ_ডিক্ল(খালি_বি(), ব্লক([])))
        r = শুরু(r, "app", ০, ০)
        r = ব্লক_ডাম্প(r, app.বডি)
        r = শেষ(r, "app")
    }
    রিটার্ন শেষ(r, "program")
}

অ্যাপ {
    ধরি আর্গ = সিস্টেম.আর্গুমেন্ট()
    যদি (দৈর্ঘ্য(আর্গ) > ০) {
        ধরি উৎস = ফাইল.পড়ো(আর্গ[০])
        ধরি l = লেক্স(উৎস)
        ধরি p = পার্সার_বানাও(l.টোকেনগুলো)
        ধরি prog = পার্স_প্রোগ্রাম(p)
        লেখো(ডাম্প(prog))
    }
}
