    m["রিটার্ন"] = ১
    m["যদি"] = ১
    m["নাহলে"] = ১
    m["লুপ"] = ১
    m["যতক্ষণ"] = ১
    m["প্রতি"] = ১
    m["বিরতি"] = ১
    m["চলবে"] = ১
    m["ইম্পোর্ট"] = ১
    m["সত্য"] = ১
    m["মিথ্যা"] = ১
    m["ফাঁকা"] = ১
    m["এবং"] = ১
    m["অথবা"] = ১
    m["না"] = ১
