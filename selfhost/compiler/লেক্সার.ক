// --- আইডেন্টিফায়ার ও কীওয়ার্ড ---

ফাংশন নাম_পড়ো(লেক্সার l, ম্যাপ[লেখা, সংখ্যা] কীওয়ার্ড) -> ফাঁকা {
    ধরি সল = l.লাইন
    ধরি সক = l.কলাম
    ধরি শুরু = l.i
    যতক্ষণ (আছে(l) এবং নাম_অংশ_কিনা(দেখো(l))) {
        এগোও(l)
    }
    ধরি কাঁচা = লেখা.স্লাইস(l.উৎস, শুরু, l.i - শুরু)
    // আইডেন্টিফায়ার (তাই কীওয়ার্ডও) NFC-নরমালাইজ করা হয়; স্ট্রিং
    // লিটারেল ইচ্ছাকৃতভাবে অপরিবর্তিত থাকে — ওগুলো নাম নয়, ডেটা।
    ধরি s = নরমাল(কাঁচা)
    যদি (আছে_কি(কীওয়ার্ড, s)) {
        টোকেন_দাও(l, কীওয়ার্ড_টো(s), সল, সক)
    } নাহলে {
        টোকেন_দাও(l, নাম_টো(s), সল, সক)
    }
}

// --- সংখ্যা ---

ফাংশন সংখ্যা_পড়ো(লেক্সার l) -> ফাঁকা {
    ধরি সল = l.লাইন
    ধরি সক = l.কলাম
    ধরি বাংলা = বাংলা_অঙ্ক_কিনা(দেখো(l))
    ধরি পাঠ = ""
    ধরি মিশ্র = মিথ্যা
    ধরি ভগ্ন = মিথ্যা
    যতক্ষণ (আছে(l) এবং যেকোনো_অঙ্ক_কিনা(দেখো(l))) {
        ধরি c = দেখো(l)
        যদি (বাংলা_অঙ্ক_কিনা(c) != বাংলা) { মিশ্র = সত্য }
        পাঠ = পাঠ + অঙ্ক_ascii_তে(c)
        এগোও(l)
    }
    // দশমিক বিন্দু তখনই সংখ্যার অংশ যখন তার পরেও অঙ্ক আছে — নইলে
    // `৫.লেখায়()`-এর মতো ফিল্ড-অ্যাক্সেস ভেঙে যেত।
    যদি (সমান(l, '.') এবং আছে২(l) এবং যেকোনো_অঙ্ক_কিনা(দেখো২(l))) {
        ভগ্ন = সত্য
        পাঠ = পাঠ + "."
        এগোও(l)
        যতক্ষণ (আছে(l) এবং যেকোনো_অঙ্ক_কিনা(দেখো(l))) {
            ধরি c২ = দেখো(l)
            যদি (বাংলা_অঙ্ক_কিনা(c২) != বাংলা) { মিশ্র = সত্য }
            পাঠ = পাঠ + অঙ্ক_ascii_তে(c২)
            এগোও(l)
        }
    }
    যদি (মিশ্র) {
        ত্রুটি(l, সল, সক, "একটি সংখ্যা লিটারেলে বাংলা ও ইংরেজি অঙ্ক মেশানো যাবে না")
    } নাহলে যদি (ভগ্ন) {
        টোকেন_দাও(l, সংখ্যা_টো(ভগ্ন_টো(দশমিকে(পাঠ))), সল, সক)
    } নাহলে {
        টোকেন_দাও(l, সংখ্যা_টো(পূর্ণ_টো(সংখ্যায়(পাঠ))), সল, সক)
    }
}

// --- এস্কেপ সিকোয়েন্স ---
// কলমে অপশন-টাইপ নেই, তাই "ব্যর্থ" বোঝাতে একটা সেন্টিনেল অক্ষর ফেরত যায়
// আর কলার `l.এস্কেপ_ঠিক` দেখে নেয়। রেফারেন্সে এটা `Option<char>`।

ফাংশন এস্কেপ_পড়ো(লেক্সার l) -> অক্ষর {
    ধরি el = l.লাইন
    ধরি ec = l.কলাম
    l.এস্কেপ_ঠিক = সত্য
    এগোও(l)
    যদি (না আছে(l)) {
        l.এস্কেপ_ঠিক = মিথ্যা
        ত্রুটি(l, el, ec, "এস্কেপ সিকোয়েন্স অসম্পূর্ণ — লিটারেল বন্ধ হয়নি")
        রিটার্ন '\u{0000}'
    }
    ধরি e = দেখো(l)
    এগোও(l)
    যদি (e == 'n') { রিটার্ন '\n' }
    যদি (e == 't') { রিটার্ন '\t' }
    যদি (e == 'r') { রিটার্ন '\r' }
    যদি (e == '\\') { রিটার্ন '\\' }
    যদি (e == '"') { রিটার্ন '"' }
    যদি (e == '\'') { রিটার্ন '\'' }
    যদি (e == 'u') { রিটার্ন ইউনিকোড_এস্কেপ_পড়ো(l, el, ec) }
    l.এস্কেপ_ঠিক = মিথ্যা
    ত্রুটি(l, el, ec, "অজানা এস্কেপ সিকোয়েন্স '\\" + লেখায়(e) + "'")
    রিটার্ন '\u{0000}'
}

ফাংশন হেক্স_অঙ্ক_কিনা(অক্ষর c) -> বুলিয়ান {
    যদি (c >= '0' এবং c <= '9') { রিটার্ন সত্য }
    যদি (c >= 'a' এবং c <= 'f') { রিটার্ন সত্য }
    রিটার্ন c >= 'A' এবং c <= 'F'
}

ফাংশন হেক্সের_মান(অক্ষর c) -> সংখ্যা {
    যদি (c >= '0' এবং c <= '9') { রিটার্ন কোডে(c) - কোডে('0') }
    যদি (c >= 'a' এবং c <= 'f') { রিটার্ন কোডে(c) - কোডে('a') + ১০ }
    রিটার্ন কোডে(c) - কোডে('A') + ১০
}

// `\u{...}` — রেফারেন্স ছয়টা হেক্স অঙ্ক পর্যন্ত নেয়, তারপর `}` চায়, আর
// মানটা বৈধ ইউনিকোড স্কেলার ভ্যালু না হলে ত্রুটি দেয়।
//
// `কোডে`/`অক্ষরে` জোড়াটা ভাষায় যোগ করা হয়েছে ঠিক এই জায়গাটার জন্য —
// এগুলো ছাড়া কলমে হেক্স থেকে অক্ষর বানানোর কোনো পথই ছিল না, আর
// `06_escapes` fixture-টা M2-এর কর্পাসে আছে, তাই প্যারিটি অসম্ভব হতো।
ফাংশন ইউনিকোড_এস্কেপ_পড়ো(লেক্সার l, সংখ্যা sl, সংখ্যা sc) -> অক্ষর {
    যদি (না সমান(l, '{')) {
        l.এস্কেপ_ঠিক = মিথ্যা
        ত্রুটি(l, sl, sc, "'\\u'-এর পরে '{' প্রত্যাশিত")
        রিটার্ন '\u{0000}'
    }
    এগোও(l)
    ধরি গুনি = ০
    ধরি মান = ০
    যতক্ষণ (আছে(l) এবং হেক্স_অঙ্ক_কিনা(দেখো(l)) এবং গুনি < ৬) {
        মান = মান * ১৬ + হেক্সের_মান(দেখো(l))
        গুনি = গুনি + ১
        এগোও(l)
    }
    যদি (গুনি == ০ অথবা না সমান(l, '}')) {
        l.এস্কেপ_ঠিক = মিথ্যা
        ত্রুটি(l, sl, sc, "অবৈধ \\u{...} এস্কেপ সিকোয়েন্স")
        রিটার্ন '\u{0000}'
    }
    এগোও(l)
    // সারোগেট (U+D800–U+DFFF) আর U+10FFFF-এর উপরের মান কোনো অক্ষর নয়।
    // `অক্ষরে` নিজেও এগুলো প্রত্যাখ্যান করে, কিন্তু সেটা রানটাইম ত্রুটি
    // ছুড়ত — লেক্সারকে ডায়াগনস্টিক দিতে হয়, থামতে নয়।
    যদি (মান > ১১১৪১১১ অথবা (মান >= ৫৫২৯৬ এবং মান <= ৫৭৩৪৩)) {
        l.এস্কেপ_ঠিক = মিথ্যা
        ত্রুটি(l, sl, sc, "\\u{...}-এ অবৈধ ইউনিকোড স্কেলার ভ্যালু")
        রিটার্ন '\u{0000}'
    }
    রিটার্ন অক্ষরে(মান)
}

// --- স্ট্রিং লিটারেল ---

ফাংশন স্ট্রিং_পড়ো(লেক্সার l) -> ফাঁকা {
    ধরি sl = l.লাইন
    ধরি sc = l.কলাম
    এগোও(l)
    ধরি s = ""
    ধরি চলবে_কি = সত্য
    যতক্ষণ (চলবে_কি) {
        যদি (না আছে(l)) {
            ত্রুটি(l, sl, sc, "লেখা লিটারেল বন্ধ হয়নি — '\"' পাওয়া যায়নি")
            চলবে_কি = মিথ্যা
        } নাহলে {
            ধরি c = দেখো(l)
            যদি (c == '"') {
                এগোও(l)
                টোকেন_দাও(l, লেখা_টো(s), sl, sc)
                চলবে_কি = মিথ্যা
            } নাহলে যদি (c == '\n' অথবা c == '\r') {
                ত্রুটি(l, sl, sc, "লেখা লিটারেলে সরাসরি নিউলাইন আসতে পারে না — '\\n' ব্যবহার করুন")
                চলবে_কি = মিথ্যা
            } নাহলে যদি (c == '\\') {
                ধরি ch = এস্কেপ_পড়ো(l)
                // ব্যর্থ এস্কেপ কিছুই যোগ করে না — রেফারেন্সে
                // `if let Some(ch) = ... { s.push(ch) }`।
                যদি (l.এস্কেপ_ঠিক) {
                    s = s + লেখায়(ch)
                }
            } নাহলে {
                s = s + লেখায়(c)
                এগোও(l)
            }
        }
    }
}

// --- ক্যারেক্টার লিটারেল ---

ফাংশন অক্ষর_ছাড়ো(লেক্সার l) -> ফাঁকা {
    যতক্ষণ (আছে(l) এবং দেখো(l) != '\'' এবং দেখো(l) != '\n' এবং দেখো(l) != '\r') {
        এগোও(l)
    }
}

ফাংশন অক্ষর_পড়ো(লেক্সার l) -> ফাঁকা {
    ধরি sl = l.লাইন
    ধরি sc = l.কলাম
    এগোও(l)
    যদি (না আছে(l)) {
        ত্রুটি(l, sl, sc, "ক্যারেক্টার লিটারেল বন্ধ হয়নি")
        রিটার্ন ফাঁকা
    }
    ধরি c = দেখো(l)
    যদি (c == '\n' অথবা c == '\r') {
        ত্রুটি(l, sl, sc, "ক্যারেক্টার লিটারেলে নিউলাইন আসতে পারে না")
        অক্ষর_ছাড়ো(l)
        যদি (সমান(l, '\'')) { এগোও(l) }
        রিটার্ন ফাঁকা
    }
    ধরি মান = '\u{0000}'
    যদি (c == '\\') {
        মান = এস্কেপ_পড়ো(l)
        // এস্কেপ ব্যর্থ হলে রেফারেন্স কোনো টোকেন দেয় না আর *বাড়তি* কোনো
        // ত্রুটিও দেয় না — এস্কেপটাই ইতিমধ্যে ত্রুটি জানিয়েছে। শুধু
        // বন্ধ-কোট পর্যন্ত এগিয়ে গিয়ে চুপচাপ ফিরে যায়।
        যদি (না l.এস্কেপ_ঠিক) {
            অক্ষর_ছাড়ো(l)
            যদি (সমান(l, '\'')) { এগোও(l) }
            রিটার্ন ফাঁকা
        }
    } নাহলে {
        মান = c
        এগোও(l)
    }
    যদি (সমান(l, '\'')) {
        এগোও(l)
        টোকেন_দাও(l, অক্ষর_টো(মান), sl, sc)
    } নাহলে {
        অক্ষর_ছাড়ো(l)
        যদি (সমান(l, '\'')) {
            এগোও(l)
            ত্রুটি(l, sl, sc, "ক্যারেক্টার লিটারেলে ঠিক একটি ক্যারেক্টার থাকতে হবে")
        } নাহলে {
            ত্রুটি(l, sl, sc, "ক্যারেক্টার লিটারেল বন্ধ হয়নি — \"'\" পাওয়া যায়নি")
        }
    }
}

// --- কমেন্ট ও '/' ---

ফাংশন স্ল্যাশ_পড়ো(লেক্সার l) -> ফাঁকা {
    যদি (সমান২(l, '/')) {
        এগোও২(l)
        যতক্ষণ (আছে(l) এবং দেখো(l) != '\n' এবং দেখো(l) != '\r') {
            এগোও(l)
        }
    } নাহলে যদি (সমান২(l, '*')) {
        ধরি sl = l.লাইন
        ধরি sc = l.কলাম
        এগোও২(l)
        ধরি বন্ধ = মিথ্যা
        যতক্ষণ (আছে(l) এবং না বন্ধ) {
            যদি (দেখো(l) == '*' এবং সমান২(l, '/')) {
                এগোও২(l)
                বন্ধ = সত্য
            } নাহলে {
                যদি (দেখো(l) == '\n') {
                    l.লাইন = l.লাইন + ১
                    l.কলাম = ১
                    l.i = l.i + ১
                } নাহলে {
                    এগোও(l)
                }
            }
        }
        যদি (না বন্ধ) {
            ত্রুটি(l, sl, sc, "কমেন্ট বন্ধ হয়নি — '*/' পাওয়া যায়নি")
        }
    } নাহলে যদি (সমান২(l, '=')) {
        টোকেন_দাও(l, চিহ্ন_টো("/="), l.লাইন, l.কলাম)
        এগোও২(l)
    } নাহলে {
        টোকেন_দাও(l, চিহ্ন_টো("/"), l.লাইন, l.কলাম)
        এগোও(l)
    }
}

// --- অপারেটর ---

// দুই-অক্ষরের অপারেটর আগে দেখা হয়, নইলে `<=` `<` আর `=` হয়ে ভেঙে যেত।
ফাংশন দুই_অক্ষরের_চিহ্ন(অক্ষর a, অক্ষর b) -> লেখা {
    যদি (a == '=' এবং b == '=') { রিটার্ন "==" }
    যদি (a == '!' এবং b == '=') { রিটার্ন "!=" }
    যদি (a == '<' এবং b == '=') { রিটার্ন "<=" }
    যদি (a == '>' এবং b == '=') { রিটার্ন ">=" }
    যদি (a == '-' এবং b == '>') { রিটার্ন "->" }
    যদি (a == '=' এবং b == '>') { রিটার্ন "=>" }
    যদি (a == '+' এবং b == '=') { রিটার্ন "+=" }
    যদি (a == '-' এবং b == '=') { রিটার্ন "-=" }
    যদি (a == '*' এবং b == '=') { রিটার্ন "*=" }
    যদি (a == '/' এবং b == '=') { রিটার্ন "/=" }
    রিটার্ন ""
}

// এক-অক্ষরের অপারেটর — না মিললে খালি লেখা, মানে অপ্রত্যাশিত ক্যারেক্টার।
ফাংশন এক_অক্ষরের_চিহ্ন(অক্ষর c) -> লেখা {
    যদি (c == '+') { রিটার্ন "+" }
    যদি (c == '-') { রিটার্ন "-" }
    যদি (c == '*') { রিটার্ন "*" }
    যদি (c == '/') { রিটার্ন "/" }
    যদি (c == '%') { রিটার্ন "%" }
    যদি (c == '=') { রিটার্ন "=" }
    যদি (c == '<') { রিটার্ন "<" }
    যদি (c == '>') { রিটার্ন ">" }
    যদি (c == ':') { রিটার্ন ":" }
    যদি (c == ',') { রিটার্ন "," }
    যদি (c == '.') { রিটার্ন "." }
    যদি (c == '(') { রিটার্ন "(" }
    যদি (c == ')') { রিটার্ন ")" }
    যদি (c == '[') { রিটার্ন "[" }
    যদি (c == ']') { রিটার্ন "]" }
    যদি (c == '{') { রিটার্ন "{" }
    যদি (c == '}') { রিটার্ন "}" }
    রিটার্ন ""
}

ফাংশন চিহ্ন_পড়ো(লেক্সার l) -> ফাঁকা {
    ধরি c = দেখো(l)
    যদি (আছে২(l)) {
        ধরি দুই = দুই_অক্ষরের_চিহ্ন(c, দেখো২(l))
        যদি (দৈর্ঘ্য(দুই) > ০) {
            টোকেন_দাও(l, চিহ্ন_টো(দুই), l.লাইন, l.কলাম)
            এগোও২(l)
            রিটার্ন ফাঁকা
        }
    }
    // একা `!` কখনো বৈধ নয় — কলমে বুলিয়ান-নট `না`, তাই এটা প্রায় সবসময়
    // `!=` লিখতে গিয়ে ভুল।
    যদি (c == '!') {
        ত্রুটি(l, l.লাইন, l.কলাম, "অপ্রত্যাশিত ক্যারেক্টর '!' — অসমতা চিহ্ন '!='")
        এগোও(l)
        রিটার্ন ফাঁকা
    }
    ধরি o = এক_অক্ষরের_চিহ্ন(c)
    যদি (দৈর্ঘ্য(o) == ০) {
        ত্রুটি(l, l.লাইন, l.কলাম, "অপ্রত্যাশিত ক্যারেক্টর '" + লেখায়(c) + "'")
        এগোও(l)
        রিটার্ন ফাঁকা
    }
    ধরি ল = l.লাইন
    ধরি ক = l.কলাম
    // বন্ধনী-জোড়ার হিসাব: খোলাগুলো স্ট্যাকে জমে, যাতে (ক) খোলা অবস্থায়
    // নিউলাইন দমন করা যায় আর (খ) ফাইল শেষে অমিল ধরা যায়।
    যদি (o == "(" অথবা o == "[") {
        // `l.খোলা[i] = ...` সরাসরি লেখা যায় না — অ্যাসাইনমেন্টের বাঁ পাশে
        // ফিল্ডের *পরে* ইনডেক্স বসে না (self-hosting-plan.md §২)। অ্যারে
        // রেফারেন্স-সদৃশ, তাই একটা ভ্যারিয়েবলে বেঁধে নিলে কাজ হয়।
        ধরি স্ট্যাক = l.খোলা
        যদি (l.খোলা_গণনা < দৈর্ঘ্য(স্ট্যাক)) {
            স্ট্যাক[l.খোলা_গণনা] = খোলা_বন্ধনী(o, ল, ক)
        } নাহলে {
            যোগ_করো(l.খোলা, খোলা_বন্ধনী(o, ল, ক))
        }
        l.খোলা_গণনা = l.খোলা_গণনা + ১
    }
    যদি (o == ")" অথবা o == "]") {
        ধরি চাই = "("
        যদি (o == "]") { চাই = "[" }
        যদি (l.খোলা_গণনা == ০) {
            ত্রুটি(l, ল, ক, "অমিল বন্ধকরণ '" + o + "'")
        } নাহলে {
            ধরি শেষটা = l.খোলা[l.খোলা_গণনা - ১]
            l.খোলা_গণনা = l.খোলা_গণনা - ১
            যদি (শেষটা.চিহ্ন != চাই) {
                ত্রুটি(l, ল, ক, "অমিল বন্ধকরণ '" + o + "'")
            }
        }
    }
    টোকেন_দাও(l, চিহ্ন_টো(o), ল, ক)
    এগোও(l)
}

// --- মূল লুপ ---
// রেফারেন্সের `Lx::run()` — ডিসপ্যাচের ক্রম হুবহু একই, কারণ ক্রমই
// অর্থ ঠিক করে: অঙ্ক আইডেন্টিফায়ারের আগে দেখা হয়, নইলে `৭ক` একটা নাম
// হয়ে যেত।
ফাংশন চালাও(লেক্সার l, ম্যাপ[লেখা, সংখ্যা] কীওয়ার্ড) -> ফাঁকা {
    যতক্ষণ (আছে(l)) {
        ধরি c = দেখো(l)
        যদি (c == '\u{FEFF}') {
            // বাইট-অর্ডার মার্ক — নীরবে বাদ, কলাম বাড়ে না
            l.i = l.i + ১
        } নাহলে যদি (c == ' ' অথবা c == '\t' অথবা c == '\u{000C}') {
            এগোও(l)
        } নাহলে যদি (c == '\r') {
            ধরি ল১ = l.লাইন
            ধরি ক১ = l.কলাম
            যদি (সমান২(l, '\n')) {
                l.i = l.i + ২
                l.কলাম = l.কলাম + ২
            } নাহলে {
                l.i = l.i + ১
                l.কলাম = l.কলাম + ১
            }
            নিউলাইন_দাও(l, ল১, ক১)
        } নাহলে যদি (c == '\n') {
            ধরি ল২ = l.লাইন
            ধরি ক২ = l.কলাম
            l.i = l.i + ১
            নিউলাইন_দাও(l, ল২, ক২)
        } নাহলে যদি (c == '/') {
            স্ল্যাশ_পড়ো(l)
        } নাহলে যদি (c == '"') {
            স্ট্রিং_পড়ো(l)
        } নাহলে যদি (c == '\'') {
            অক্ষর_পড়ো(l)
        } নাহলে যদি (যেকোনো_অঙ্ক_কিনা(c)) {
            সংখ্যা_পড়ো(l)
        } নাহলে যদি (নাম_শুরু_কিনা(c)) {
            নাম_পড়ো(l, কীওয়ার্ড)
        } নাহলে {
            চিহ্ন_পড়ো(l)
        }
    }
}

// একটা সোর্স-স্ট্রিং লেক্স করে ভরা `লেক্সার` ফেরত দেয় — টোকেন ও
// ডায়াগনস্টিক দুটোই তার ভেতরে।
ফাংশন লেক্স(লেখা উৎস) -> লেক্সার {
    ধরি l = লেক্সার_বানাও(উৎস)
    চালাও(l, কীওয়ার্ড_টেবিল())
    // ফাইল শেষ, কিন্তু বন্ধনী খোলা — রেফারেন্সও এখানেই এই ত্রুটিগুলো দেয়।
    ধরি i = ০
    যতক্ষণ (i < l.খোলা_গণনা) {
        ধরি খ = l.খোলা[i]
        ত্রুটি(l, খ.লাইন, খ.কলাম, "'" + খ.চিহ্ন + "' খোলা অবস্থায় ফাইল শেষ — বন্ধ হয়নি")
        i = i + ১
    }
    রিটার্ন l
}
