// এক-টোকেন লুকঅ্যাহেড — শুধু `টাইপ[]` প্যাটার্নের জন্য, যেখানে `[`-এর
// পরপরই `]` লাগবে (ইনডেক্স-এক্সপ্রেশনের `[`-থেকে আলাদা করতে, যেমন
// রেফারেন্সের `parse_type`)।
ফাংশন পরের_চিহ্ন_কি(পার্সার p, লেখা s) -> বুলিয়ান {
    ধরি j = p.সূচক + ১
    যদি (j >= দৈর্ঘ্য(p.টোকেনগুলো)) {
        রিটার্ন মিথ্যা
    }
    রিটার্ন মিলাও p.টোকেনগুলো[j].ধরন {
        চিহ্ন_টো(o) => o == s,
        নাম_টো(x) => মিথ্যা,
        কীওয়ার্ড_টো(x) => মিথ্যা,
        সংখ্যা_টো(x) => মিথ্যা,
        লেখা_টো(x) => মিথ্যা,
        অক্ষর_টো(x) => মিথ্যা,
        নতুনলাইন_টো => মিথ্যা,
    }
}

// --- টাইপ ---
// রেফারেন্সের `parse_type`/`parse_type_base`।

ফাংশন পার্স_টাইপ_ভিত্তি_শেয়ার_সহ(পার্সার p) -> টাইপ_এক্সপ্র {
    যদি (এ_কীওয়ার্ড_কি(p, "শেয়ার")) {
        কার্সর_এগোও(p)
        রিটার্ন শেয়ার_টে(শেয়ার_করো(পার্স_টাইপ_বেস(p)))
    }
    রিটার্ন পার্স_টাইপ_বেস(p)
}

ফাংশন পার্স_টাইপ(পার্সার p) -> টাইপ_এক্সপ্র {
    ধরি ty = পার্স_টাইপ_ভিত্তি_শেয়ার_সহ(p)
    ধরি থামো = মিথ্যা
    যতক্ষণ (না থামো) {
        যদি (এ_চিহ্ন_কি(p, "[") এবং পরের_চিহ্ন_কি(p, "]")) {
            কার্সর_এগোও(p)
            কার্সর_এগোও(p)
            ty = অ্যারে_টে(শেয়ার_করো(ty))
        } নাহলে {
            থামো = সত্য
        }
    }
    রিটার্ন ty
}

ফাংশন পার্স_টাইপ_বেস(পার্সার p) -> টাইপ_এক্সপ্র {
    ধরি pজ = বর্তমান_পজ(p)

    যদি (এ_চিহ্ন_কি(p, "(")) {
        কার্সর_এগোও(p)
        ধরি প্যারামগুলো: টাইপ_এক্সপ্র[] = []
        যদি (না এ_চিহ্ন_কি(p, ")")) {
            ধরি আরও = সত্য
            যতক্ষণ (আরও) {
                যোগ_করো(প্যারামগুলো, পার্স_টাইপ(p))
                যদি (না খাও_চিহ্ন(p, ",")) {
                    আরও = মিথ্যা
                }
            }
        }
        প্রত্যাশিত_চিহ্ন(p, ")")
        যদি (না এ_চিহ্ন_কি(p, "->")) {
            ডায়াগ_এখানে(p, "'->' প্রত্যাশিত — ফাংশন-টাইপে রিটার্ন টাইপ আবশ্যক")
        }
        খাও_চিহ্ন(p, "->")
        ধরি ret = পার্স_টাইপ(p)
        রিটার্ন ফাংশন_টে(প্যারামগুলো, শেয়ার_করো(ret))
    }

    ধরি কী = বর্তমান_কীওয়ার্ড(p)
    যদি (কী == "ম্যাপ") {
        কার্সর_এগোও(p)
        যদি (না প্রত্যাশিত_চিহ্ন(p, "[")) {
            রিটার্ন নাম_টে(আইডি("ম্যাপ", pজ))
        }
        ধরি কী_টাইপ = পার্স_টাইপ(p)
        যদি (না প্রত্যাশিত_চিহ্ন(p, ",")) {
            রিটার্ন নাম_টে(আইডি("ম্যাপ", pজ))
        }
        ধরি মান_টাইপ = পার্স_টাইপ(p)
        প্রত্যাশিত_চিহ্ন(p, "]")
        রিটার্ন ম্যাপ_টে(শেয়ার_করো(কী_টাইপ), শেয়ার_করো(মান_টাইপ))
    }
    যদি (দৈর্ঘ্য(কী) > ০ এবং প্রিমিটিভ_টাইপ_কিনা(কী)) {
        কার্সর_এগোও(p)
        রিটার্ন নাম_টে(আইডি(কী, pজ))
    }
    যদি (এ_নাম_কি(p)) {
        ধরি নাম = বর্তমান_নাম(p)
        কার্সর_এগোও(p)
        যদি (এ_চিহ্ন_কি(p, "<")) {
            কার্সর_এগোও(p)
            ধরি আর্গগুলো: টাইপ_এক্সপ্র[] = []
            যদি (না এ_চিহ্ন_কি(p, ">")) {
                ধরি আরও২ = সত্য
                যতক্ষণ (আরও২) {
                    যোগ_করো(আর্গগুলো, পার্স_টাইপ(p))
                    যদি (না খাও_চিহ্ন(p, ",")) {
                        আরও২ = মিথ্যা
                    }
                }
            }
            প্রত্যাশিত_চিহ্ন(p, ">")
            রিটার্ন জেনেরিক_টে(আইডি(নাম, pজ), আর্গগুলো)
        }
        রিটার্ন নাম_টে(আইডি(নাম, pজ))
    }
    ডায়াগ_এখানে(p, "টাইপ প্রত্যাশিত")
    যদি (বাকি_আছে(p)) {
        কার্সর_এগোও(p)
    }
    রিটার্ন নাম_টে(আইডি("ত্রুটি", pজ))
}

// রেফারেন্সের `parse_type_params` — `তথ্য`/`এনাম`/`ফাংশন`-এর নামের পরে
// ঐচ্ছিক `<T, ...>`। কোনো `<` না থাকলে খালি অ্যারে (ত্রুটি না) — জেনেরিক্স
// অপ্ট-ইন।
ফাংশন পার্স_টাইপ_প্যারাম(পার্সার p) -> আইডি[] {
    ধরি প্যারামগুলো: আইডি[] = []
    যদি (না খাও_চিহ্ন(p, "<")) {
        রিটার্ন প্যারামগুলো
    }
    যদি (না এ_চিহ্ন_কি(p, ">")) {
        ধরি আরও = সত্য
        যতক্ষণ (আরও) {
            ধরি নাম = প্রত্যাশিত_আইডি(p, "টাইপ-প্যারামিটারের নাম")
            যোগ_করো(প্যারামগুলো, নাম)
            যদি (না খাও_চিহ্ন(p, ",")) {
                আরও = মিথ্যা
            }
        }
    }
    প্রত্যাশিত_চিহ্ন(p, ">")
    রিটার্ন প্যারামগুলো
}

// --- মূল প্রোগ্রাম পার্সার ---

ফাংশন পার্স_প্রোগ্রাম(পার্সার p) -> প্রোগ্রাম {
    ধরি prog = প্রোগ্রাম([], [], [], [], [], [], খালি_বি())
    এড়িয়ে_যাও_নতুনলাইন(p)
    যতক্ষণ (বাকি_আছে(p)) {
        যদি (এ_কীওয়ার্ড_কি(p, "ইম্পোর্ট")) {
            খাও_কীওয়ার্ড(p, "ইম্পোর্ট")
            ধরি মড = প্রত্যাশিত_মডিউল_নাম(p)
            যোগ_করো(prog.ইম্পোর্টগুলো, মড)
            স্টেট_শেষ(p)
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "অ্যাপ")) {
            যদি (আছে_বি(prog.অ্যাপ_ঘোষণা)) {
                ডায়াগ_এখানে(p, "একাধিক 'অ্যাপ' ডিক্লারেশন")
            }
            prog.অ্যাপ_ঘোষণা = কিছু_বি(পার্স_অ্যাপ(p))
            এড়িয়ে_যাও_নতুনলাইন(p)
            যদি (বাকি_আছে(p)) {
                ডায়াগ_এখানে(p, "'অ্যাপ'-এর পরে শুধু নতুন লাইন থাকতে পারে")
                রিকভার_শীর্ষ(p)
                এড়িয়ে_যাও_নতুনলাইন(p)
            }
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "তথ্য")) {
            ধরি s = পার্স_স্ট্রাক্ট_ডিক্ল(p)
            যদি (আছে_বি(s)) {
                যোগ_করো(prog.স্ট্রাক্টগুলো, খুলুন_বি(s, স্ট্রাক্ট_ডিক্ল([], [], [])))
            }
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "এনাম")) {
            ধরি e = পার্স_এনাম_ডিক্ল(p)
            যদি (আছে_বি(e)) {
                যোগ_করো(prog.এনামগুলো, খুলুন_বি(e, এনাম_ডিক্ল(আইডি("", পজ(১, ১)), [], [])))
            }
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "ফাংশন")) {
            ধরি f = পার্স_ফাংশন_ডিক্ল(p)
            যোগ_করো(prog.ফাংশনগুলো, f)
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "এক্সটার্ন")) {
            ধরি ext = পার্স_এক্সটার্ন_ব্লক(p)
            যদি (আছে_বি(ext)) {
                যোগ_করো(prog.এক্সটার্নগুলো, খুলুন_বি(ext, এক্সটার্ন_ব্লক("", পজ(১, ১), [])))
            }
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে যদি (এ_কীওয়ার্ড_কি(p, "ধ্রুবক")) {
            ধরি c = পার্স_ধ্রুবক_ডিক্ল(p)
            যদি (আছে_বি(c)) {
                যোগ_করো(prog.ধ্রুবকগুলো, খুলুন_বি(c, ধ্রুবক_ডিক্ল(আইডি("", পজ(১, ১)), নাম_টে(আইডি("", পজ(১, ১))), লিট_এক(নাল_লি))))
            }
            এড়িয়ে_যাও_নতুনলাইন(p)
        } নাহলে {
            ডায়াগ_এখানে(p, "ডিক্লারেশন প্রত্যাশিত")
            রিকভার_শীর্ষ(p)
            এড়িয়ে_যাও_নতুনলাইন(p)
        }
    }
    রিটার্ন prog
}

// --- ডিক্লারেশন পার্সার ---

ফাংশন পার্স_অ্যাপ(পার্সার p) -> অ্যাপ_ডিক্ল {
    খাও_কীওয়ার্ড(p, "অ্যাপ")
    ধরি body = পার্স_ব্লক(p)
    রিটার্ন অ্যাপ_ডিক্ল(খালি_বি(), body)
}

ফাংশন পার্স_স্ট্রাক্ট_ডিক্ল(পার্সার p) -> বিকল্প<স্ট্রাক্ট_ডিক্ল> {
    খাও_কীওয়ার্ড(p, "তথ্য")
    ধরি নাম = প্রত্যাশিত_আইডি(p, "স্ট্রাক্টের নাম")
    ধরি টাইপপ্যারাম = পার্স_টাইপ_প্যারাম(p)
    ধরি ফিল্ডগুলো: স্ট্রাক্ট_ফিল্ড[] = []
    প্রত্যাশিত_চিহ্ন(p, "{")
    এড়িয়ে_যাও_নতুনলাইন(p)
    যতক্ষণ (না এ_চিহ্ন_কি(p, "}")) {
        ধরি fনাম = প্রত্যাশিত_মেম্বার_নাম(p, "ফিল্ডের নাম")
        প্রত্যাশিত_চিহ্ন(p, ":")
        ধরি fটাইপ = পার্স_টাইপ(p)
        যোগ_করো(ফিল্ডগুলো, স্ট্রাক্ট_ফিল্ড(fনাম, fটাইপ))
        স্টেট_শেষ(p)
        এড়িয়ে_যাও_নতুনলাইন(p)
    }
    প্রত্যাশিত_চিহ্ন(p, "}")
    রিটার্ন কিছু_বি(স্ট্রাক্ট_ডিক্ল(নাম, টাইপপ্যারাম, ফিল্ডগুলো))
}

ফাংশন পার্স_এনাম_ডিক্ল(পার্সার p) -> বিকল্প<এনাম_ডিক্ল> {
    খাও_কীওয়ার্ড(p, "এনাম")
    ধরি নাম = প্রত্যাশিত_আইডি(p, "এনামের নাম")
    ধরি টাইপপ্যারাম = পার্স_টাইপ_প্যারাম(p)
    ধরি ভ্যারিয়েন্টগুলো: এনাম_ভ্যারিয়েন্ট[] = []
    প্রত্যাশিত_চিহ্ন(p, "{")
    এড়িয়ে_যাও_নতুনলাইন(p)
    যতক্ষণ (না এ_চিহ্ন_কি(p, "}")) {
        ধরি vনাম = প্রত্যাশিত_আইডি(p, "ভ্যারিয়েন্টের নাম")
        ধরি পেলোড_টাইপগুলো: টাইপ_এক্সপ্র[] = []
        যদি (এ_চিহ্ন_কি(p, "(")) {
            কার্সর_এগোও(p)
            যদি (না এ_চিহ্ন_কি(p, ")")) {
                ধরি আরও = সত্য
                যতক্ষণ (আরও) {
                    যোগ_করো(পেলোড_টাইপগুলো, পার্স_টাইপ(p))
                    যদি (না খাও_চিহ্ন(p, ",")) {
                        আরও = মিথ্যা
                    }
                }
            }
            প্রত্যাশিত_চিহ্ন(p, ")")
        }
        যোগ_করো(ভ্যারিয়েন্টগুলো, এনাম_ভ্যারিয়েন্ট(vনাম, পেলোড_টাইপগুলো))
        স্টেট_শেষ(p)
        এড়িয়ে_যাও_নতুনলাইন(p)
    }
    প্রত্যাশিত_চিহ্ন(p, "}")
    রিটার্ন কিছু_বি(এনাম_ডিক্ল(নাম, টাইপপ্যারাম, ভ্যারিয়েন্টগুলো))
}

ফাংশন পার্স_ফাংশন_ডিক্ল(পার্সার p) -> ফাংশন_ডিক্ল {
    খাও_কীওয়ার্ড(p, "ফাংশন")
    ধরি নাম = প্রত্যাশিত_আইডি(p, "ফাংশনের নাম")
    ধরি টাইপপ্যারাম = পার্স_টাইপ_প্যারাম(p)
    ধরি প্যারামগুলো: প্যারাম[] = []
    প্রত্যাশিত_চিহ্ন(p, "(")
    যদি (না এ_চিহ্ন_কি(p, ")")) {
        ধরি আরও = সত্য
        যতক্ষণ (আরও) {
            ধরি pটাইপ = পার্স_টাইপ(p)
            ধরি pনাম = প্রত্যাশিত_আইডি(p, "প্যারামিটারের নাম")
            যোগ_করো(প্যারামগুলো, প্যারাম(pটাইপ, pনাম))
            যদি (না খাও_চিহ্ন(p, ",")) {
                আরও = মিথ্যা
            }
        }
    }
    প্রত্যাশিত_চিহ্ন(p, ")")
    প্রত্যাশিত_চিহ্ন(p, "->")
    ধরি ret = পার্স_টাইপ(p)
    ধরি body = পার্স_ব্লক(p)
    রিটার্ন ফাংশন_ডিক্ল(নাম, টাইপপ্যারাম, প্যারামগুলো, ret, body)
}

ফাংশন পার্স_এক্সটার্ন_ব্লক(পার্সার p) -> বিকল্প<এক্সটার্ন_ব্লক> {
    খাও_কীওয়ার্ড(p, "এক্সটার্ন")
    ধরি pজ = বর্তমান_পজ(p)
    ধরি এবিআই = বর্তমান_স্ট্রিং(p)
    যদি (দৈর্ঘ্য(এবিআই) == ০) {
        ডায়াগ_এখানে(p, "ABI স্ট্রিং প্রত্যাশিত")
        রিটার্ন খালি_বি()
    }
    কার্সর_এগোও(p)
    ধরি ফাংশনগুলো: এক্সটার্ন_ফাংশন[] = []
    প্রত্যাশিত_চিহ্ন(p, "{")
    এড়িয়ে_যাও_নতুনলাইন(p)
    যতক্ষণ (না এ_চিহ্ন_কি(p, "}")) {
        ধরি fname = প্রত্যাশিত_আইডি(p, "ফাংশনের নাম")
        ধরি fparams: প্যারাম[] = []
        প্রত্যাশিত_চিহ্ন(p, "(")
        যদি (না এ_চিহ্ন_কি(p, ")")) {
            ধরি আরও = সত্য
            যতক্ষণ (আরও) {
                ধরি pটাইপ = পার্স_টাইপ(p)
                ধরি pনাম = প্রত্যাশিত_আইডি(p, "প্যারামিটারের নাম")
                যোগ_করো(fparams, প্যারাম(pটাইপ, pনাম))
                যদি (না খাও_চিহ্ন(p, ",")) {
                    আরও = মিথ্যা
                }
            }
        }
        প্রত্যাশিত_চিহ্ন(p, ")")
        প্রত্যাশিত_চিহ্ন(p, "->")
        ধরি fret = পার্স_টাইপ(p)
        যোগ_করো(ফাংশনগুলো, এক্সটার্ন_ফাংশন(fname, fparams, fret))
        স্টেট_শেষ(p)
        এড়িয়ে_যাও_নতুনলাইন(p)
    }
    প্রত্যাশিত_চিহ্ন(p, "}")
    রিটার্ন কিছু_বি(এক্সটার্ন_ব্লক(এবিআই, pজ, ফাংশনগুলো))
}

ফাংশন পার্স_ধ্রুবক_ডিক্ল(পার্সার p) -> বিকল্প<ধ্রুবক_ডিক্ল> {
    খাও_কীওয়ার্ড(p, "ধ্রুবক")
    ধরি নাম = প্রত্যাশিত_আইডি(p, "'ধ্রুবক'-এর পরে নাম")
    যদি (না খাও_চিহ্ন(p, ":")) {
        ডায়াগ_এখানে(p, "':' প্রত্যাশিত — ধ্রুবকে টাইপ অ্যানোটেশন আবশ্যক")
        যতক্ষণ (না খাও_নতুনলাইন_বা_বন্ধ(p) এবং বাকি_আছে(p)) {
            কার্সর_এগোও(p)
        }
        রিটার্ন খালি_বি()
    }
    ধরি টাইপ = পার্স_টাইপ(p)
    যদি (না খাও_চিহ্ন(p, "=")) {
        ডায়াগ_এখানে(p, "'=' প্রত্যাশিত")
        যতক্ষণ (না খাও_নতুনলাইন_বা_বন্ধ(p) এবং বাকি_আছে(p)) {
            কার্সর_এগোও(p)
        }
        রিটার্ন খালি_বি()
    }
    ধরি init = পার্স_এক্সপ্র(p)
    রিটার্ন কিছু_বি(ধ্রুবক_ডিক্ল(নাম, টাইপ, init))
}

// --- এক্সপ্রেশন পার্সার ---

ফাংশন এক্সপ্র_শুরু_কি(পার্সার p) -> বুলিয়ান {
    যদি (এ_নাম_কি(p) অথবা এ_সংখ্যা_কি(p) অথবা এ_স্ট্রিং_কি(p) অথবা এ_অক্ষর_কি(p)) {
        রিটার্ন সত্য
    }
    ধরি ক = বর্তমান_কীওয়ার্ড(p)
    যদি (ক == "সত্য" অথবা ক == "মিথ্যা" অথবা ক == "ফাঁকা" অথবা ক == "না" অথবা ক == "মিলাও") {
        রিটার্ন সত্য
    }
    যদি (এ_চিহ্ন_কি(p, "(") অথবা এ_চিহ্ন_কি(p, "[") অথবা এ_চিহ্ন_কি(p, "-")) {
        রিটার্ন সত্য
    }
    রিটার্ন মিথ্যা
}

ফাংশন পার্স_এক্সপ্র(পার্সার p) -> এক্সপ্র {
    রিটার্ন পার্স_অ্যাসাইন(p)
}

ফাংশন পার্স_অ্যাসাইন(পার্সার p) -> এক্সপ্র {
    যদি (এ_নাম_কি(p)) {
        ধরি সংরক্ষণ = p.সূচক
        ধরি base = প্রত্যাশিত_আইডি(p, "ভ্যারিয়েবল")
        ধরি idx: এক্সপ্র[] = []
        ধরি ফিল্ড: বিকল্প<আইডি> = খালি_বি()
        
        যতক্ষণ (এ_চিহ্ন_কি(p, "[")) {
            কার্সর_এগোও(p)
            যোগ_করো(idx, পার্স_এক্সপ্র(p))
            প্রত্যাশিত_চিহ্ন(p, "]")
        }
        
        যদি (এ_চিহ্ন_কি(p, ".")) {
            কার্সর_এগোও(p)
            ধরি mk = মেম্বার_কীওয়ার্ড(p)
            ফিল্ড = মিলাও mk {
                কিছু_বি(id) => কিছু_বি(id),
                খালি_বি => যদি (এ_নাম_কি(p)) {
                    ধরি fname = বর্তমান_নাম(p)
                    ধরি fpos = বর্তমান_পজ(p)
                    কার্সর_এগোও(p)
                    কিছু_বি(আইডি(fname, fpos))
                } নাহলে {
                    খালি_বি()
                }
            }
        }
        
        যদি (এ_চিহ্ন_কি(p, "=")) {
            ধরি pos = base.পজ
            কার্সর_এগোও(p)
            ধরি rhs = পার্স_অ্যাসাইন(p)
            রিটার্ন এক্সপ্র(অ্যাসাইন_এক(এলভ্যালু(base, idx, ফিল্ড), শেয়ার_করো(rhs)), pos)
        }
        
        // Struct field assignment সমর্থন করতে হবে
        p.সূচক = সংরক্ষণ
    }
    রিটার্ন পার্স_অথবা(p)
}

ফাংশন পার্স_অথবা(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_এবং, [], [("অথবা", এবং_বা)])
}

ফাংশন পার্স_এবং(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_সমান, [], [("এবং", এবং_বা)])
}

ফাংশন পার্স_সমান(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_তুলনা, [("==", সমান_বা), ("!=", অসমান_বা)], [])
}

ফাংশন পার্স_তুলনা(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_যোগ, [("<", ছোট_বা), (">", বড়_বা), ("<=", ছোটসম_বা), (">=", বড়সম_বা)], [])
}

ফাংশন পার্স_যোগ(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_গুণ, [("+", যোগ_বা), ("-", বিয়োগ_বা)], [])
}

ফাংশন পার্স_গুণ(পার্সার p) -> এক্সপ্র {
    রিটার্ন বাইনারি_ল্যাডার(p, পার্স_ইউনারি, [("*", গুণ_বা), ("/", ভাগ_বা), ("%", ভাগশেষ_বা)], [])
}

ফাংশন পার্স_ইউনারি(পার্সার p) -> এক্সপ্র {
    যদি (এ_চিহ্ন_কি(p, "-")) {
        ধরি pos = বর্তমান_পজ(p)
        কার্সর_এগোও(p)
        ধরি e = পার্স_ইউনারি(p)
        রিটার্ন এক্সপ্র(ইউনারি_এক(নেগ_ইউ, শেয়ার_করো(e)), pos)
    }
    যদি (এ_কীওয়ার্ড_কি(p, "না")) {
        ধরি pos = বর্তমান_পজ(p)
        কার্সর_এগোও(p)
        ধরি e = পার্স_ইউনারি(p)
        রিটার্ন এক্সপ্র(ইউনারি_এক(নট_ইউ, শেয়ার_করো(e)), pos)
    }
    রিটার্ন পার্স_পোস্টফিক্স(p)
}

ফাংশন পার্স_পোস্টফিক্স(পার্সার p) -> এক্সপ্র {
    ধরি e = পার্স_প্রাইমারি(p)
    ধরি sfx: সাফিক্স[] = []
    
    যতক্ষণ (এ_চিহ্ন_কি(p, "(") অথবা এ_চিহ্ন_কি(p, "[")) {
        যদি (এ_চিহ্ন_কি(p, "(")) {
            ধরি pos = বর্তমান_পজ(p)
            কার্সর_এগোও(p)
            ধরি args: এক্সপ্র[] = []
            যদি (না এ_চিহ্ন_কি(p, ")")) {
                ধরি আরও = সত্য
                যতক্ষণ (আরও) {
                    যোগ_করো(args, পার্স_এক্সপ্র(p))
                    যদি (না খাও_চিহ্ন(p, ",")) {
                        আরও = মিথ্যা
                    }
                }
            }
            প্রত্যাশিত_চিহ্ন(p, ")")
            যোগ_করো(sfx, কল_সাফ(args, pos))
        } নাহলে যদি (এ_চিহ্ন_কি(p, "[")) {
            ধরি pos = বর্তমান_পজ(p)
            কার্সর_এগোও(p)
            ধরি idx = পার্স_এক্সপ্র(p)
            প্রত্যাশিত_চিহ্ন(p, "]")
            যোগ_করো(sfx, ইনডেক্স_সাফ(শেয়ার_করো(idx), pos))
        }
    }
    
    যদি (এ_চিহ্ন_কি(p, ".")) {
        কার্সর_এগোও(p)
        ধরি fname = প্রত্যাশিত_মেম্বার_নাম(p, "ফিল্ডের নাম")
        যোগ_করো(sfx, ফিল্ড_সাফ(fname))
    }
    
    রিটার্ন এক্সপ্র(পোস্টফিক্স_এক(শেয়ার_করো(e), sfx), e.পজ)
}

ফাংশন পার্স_প্রাইমারি(পার্সার p) -> এক্সপ্র {
    ধরি pজ = বর্তমান_পজ(p)
    
    যদি (এ_চিহ্ন_কি(p, "(")) {
        কার্সর_এগোও(p)
        ধরি e = পার্স_এক্সপ্র(p)
        প্রত্যাশিত_চিহ্ন(p, ")")
        রিটার্ন e
    }
    
    যদি (এ_চিহ্ন_কি(p, "[")) {
        কার্সর_এগোও(p)
        ধরি elems: এক্সপ্র[] = []
        যদি (না এ_চিহ্ন_কি(p, "]")) {
            ধরি আরও = সত্য
            যতক্ষণ (আরও) {
                যোগ_করো(elems, পার্স_এক্সপ্র(p))
                যদি (না খাও_চিহ্ন(p, ",")) {
                    আরও = মিথ্যা
                }
            }
        }
        প্রত্যাশিত_চিহ্ন(p, "]")
        রিটার্ন এক্সপ্র(লিট_এক(অ্যারে_লি(elems)), pজ)
    }
    
    যদি (এ_নাম_কি(p)) {
        ধরি নাম = বর্তমান_নাম(p)
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(আইডি_এক(আইডি(নাম, pজ)), pজ)
    }
    
    যদি (এ_সংখ্যা_কি(p)) {
        ধরি tok = বর্তমান_সংখ্যা_টোকেন(p)
        কার্সর_এগোও(p)
        রিটার্ন মিলাও tok {
            কিছু_বি(v) => মিলাও v {
                পূর্ণ_টো(x) => এক্সপ্র(লিট_এক(ইন্ট_লি(x)), pজ),
                ভগ্ন_টো(y) => এক্সপ্র(লিট_এক(ফ্লোট_লি(y)), pজ),
            },
            খালি_বি => এক্সপ্র(লিট_এক(ইন্ট_লি(০)), pজ),
        }
    }
    
    যদি (এ_স্ট্রিং_কি(p)) {
        ধরি s = বর্তমান_স্ট্রিং(p)
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(লিট_এক(স্ট্র_লি(s)), pজ)
    }
    
    যদি (এ_অক্ষর_কি(p)) {
        ধরি c = বর্তমান_অক্ষর(p)
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(লিট_এক(চার_লি(c)), pজ)
    }
    
    ধরি ক = বর্তমান_কীওয়ার্ড(p)
    যদি (ক == "সত্য") {
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(লিট_এক(বুল_লি(সত্য)), pজ)
    }
    যদি (ক == "মিথ্যা") {
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(লিট_এক(বুল_লি(মিথ্যা)), pজ)
    }
    যদি (ক == "ফাঁকা") {
        কার্সর_এগোও(p)
        রিটার্ন এক্সপ্র(লিট_এক(নাল_লি), pজ)
    }
    
    ডায়াগ_এখানে(p, "এক্সপ্রেশন প্রত্যাশিত")
    রিটার্ন এক্সপ্র(লিট_এক(নাল_লি), pজ)
}

ফাংশন বাইনারি_ল্যাডার(পার্সার p, ফাংশন(পার্সার) -> এক্সপ্র lower, লেখা[] ops, লেখা[] kw_ops) -> এক্সপ্র {
    ধরি lhs = lower(p)
    ধরি থামো = মিথ্যা
    যতক্ষণ (না থামো) {
        ধরি found_op: বিকল্প<বাইনারি_অপ> = খালি_বি()
        ধরি found_pos: বিকল্প<পজ> = খালি_বি()
        
        // চিহ্ন অপারেটর চেক
        ধরি op = বর্তমান_চিহ্ন(p)
        ধরি i = ০
        যতক্ষণ (i < দৈর্ঘ্য(ops)) {
            যদি (op == ops[i]) {
                found_op = কিছু_বি(মিলাও ops[i] {
                    "+" => যোগ_বা,
                    "-" => বিয়োগ_বা,
                    "*" => গুণ_বা,
                    "/" => ভাগ_বা,
                    "%" => ভাগশেষ_বা,
                    "==" => সমান_বা,
                    "!=" => অসমান_বা,
                    "<" => ছোট_বা,
                    ">" => বড়_বা,
                    "<=" => ছোটসম_বা,
                    ">=" => বড়সম_বা,
                    _ => যোগ_বা
                })
                found_pos = কিছু_বি(বর্তমান_পজ(p))
                থামো = সত্য
            }
            i = i + ১
        }
        
        // কীওয়ার্ড অপারেটর চেক
        ধরি kw = বর্তমান_কীওয়ার্ড(p)
        ধরি j = ০
        যতক্ষণ (j < দৈর্ঘ্য(kw_ops)) {
            যদি (kw == kw_ops[j]) {
                found_op = কিছু_বি(মিলাও kw_ops[j] {
                    "এবং" => এবং_বা,
                    "অথবা" => অথবা_বা,
                    _ => এবং_বা
                })
                found_pos = কিছু_বি(বর্তমান_পজ(p))
                থামো = সত্য
            }
            j = j + ১
        }
        
        যদি (আছে_বি(found_op) এবং আছে_বি(found_pos)) {
            কার্সর_এগোও(p)
            ধরি rhs = lower(p)
            lhs = এক্সপ্র(বাইনারি_এক(খুলুন_বি(found_op, যোগ_বা), শেয়ার_করো(lhs), শেয়ার_করো(rhs)), খুলুন_বি(found_pos, পজ(১, ১)))
            থামো = মিথ্যা
        } নাহলে {
            থামো = সত্য
        }
    }
    রিটার্ন lhs
}

// --- স্টেটমেন্ট পার্সার ---

ফাংশন পার্স_ব্লক(পার্সার p) -> ব্লক {
    ধরি stmts: স্টেট[] = []
    প্রত্যাশিত_চিহ্ন(p, "{")
    এড়িয়ে_যাও_নতুনলাইন(p)
    যতক্ষণ (না এ_চিহ্ন_কি(p, "}")) {
        যোগ_করো(stmts, পার্স_স্টেট(p))
        এড়িয়ে-যাও_নতুনলাইন(p)
    }
    প্রত্যাশিত_চিহ্ন(p, "}")
    রিটার্ন ব্লক(stmts)
}

ফাংশন পার্স_স্টেট(পার্সার p) -> স্টেট {
    ধরি pজ = বর্তমান_পজ(p)
    
    যদি (এ_কীওয়ার্ড_কি(p, "ধরি")) {
        খাও_কীওয়ার্ড(p, "ধরি")
        ধরি নাম = প্রত্যাশিত_আইডি(p, "ভ্যারিয়েবলের নাম")
        ধরি টাইপ: বিকল্প<টাইপ_এক্সপ্র> = খালি_বি()
        যদি (খাও_চিহ্ন(p, ":")) {
            টাইপ = কিছু_বি(পার্স_টাইপ(p))
        }
        প্রত্যাশিত_চিহ্ন(p, "=")
        ধরি init = পার্স_এক্সপ্র(p)
        স্টেট_শেষ(p)
        রিটার্ন ভ্যার_স্ট(ভ্যার_ডিক্ল(নাম, টাইপ, init))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "ধ্রুবক")) {
        ধরি c = পার্স_ধ্রুবক_ডিক্ল(p)
        যদি (আছে_বি(c)) {
            স্টেট_শেষ(p)
            রিটার্ন ধ্রুবক_স্ট(খুলুন_বি(c, ধ্রুবক_ডিক্ল(আইডি("", পজ(১, ১)), নাম_টে(আইডি("", পজ(১, ১))), লিট_এক(নাল_লি))))
        }
        রিটার্ন এক্সপ্র_স্ট(এক্সপ্র(লিট_এক(নাল_লি), pজ))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "যদি")) {
        ধরি if_stmt = পার্স_যদি(p)
        স্টেট_শেষ(p)
        রিটার্ন ইফ_স্ট(if_stmt)
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "লুপ")) {
        খাও_কীওয়ার্ড(p, "লুপ")
        প্রত্যাশিত_চিহ্ন(p, "(")
        ধরি count = পার্স_এক্সপ্র(p)
        প্রত্যাশিত_চিহ্ন(p, ")")
        ধরি body = পার্স_ব্লক(p)
        স্টেট_শেষ(p)
        রিটার্ন লুপ_স্ট(লুপ_স্ট্যাট(pজ, count, body))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "যতক্ষণ")) {
        খাও_কীওয়ার্ড(p, "যতক্ষণ")
        প্রত্যাশিত_চিহ্ন(p, "(")
        ধরি cond = পার্স_এক্সপ্র(p)
        প্রত্যাশিত_চিহ্ন(p, ")")
        ধরি body = পার্স_ব্লক(p)
        স্টেট_শেষ(p)
        রিটার্ন হোয়াইল_স্ট(হোয়াইল_স্ট্যাট(pজ, cond, body))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "প্রতি")) {
        খাও_কীওয়ার্ড(p, "প্রতি")
        ধরি var = প্রত্যাশিত_আইডি(p, "লুপ ভ্যারিয়েবল")
        প্রত্যাশিত_চিহ্ন(p, ":")
        ধরি iter = পার্স_এক্সপ্র(p)
        ধরি body = পার্স_ব্লক(p)
        স্টেট_শেষ(p)
        রিটার্ন ফরইচ_স্ট(ফরইচ_স্ট্যাট(pজ, var, iter, body))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "রিটার্ন")) {
        খাও_কীওয়ার্ড(p, "রিটার্ন")
        ধরি val: বিকল্প<এক্সপ্র> = খালি_বি()
        যদি (এক্সপ্র_শুরু_কি(p)) {
            val = কিছু_বি(পার্স_এক্সপ্র(p))
        }
        স্টেট_শেষ(p)
        রিটার্ন রিটার্ন_স্ট(রিটার্ন_স্ট্যাট(pজ, val))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "বিরতি")) {
        খাও_কীওয়ার্ড(p, "বিরতি")
        স্টেট_শেষ(p)
        রিটার্ন ব্রেক_স্ট(pজ)
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "চলবে")) {
        খাও_কীওয়ার্ড(p, "চলবে")
        স্টেট_শেষ(p)
        রিটার্ন কন্টিনিউ_স্ট(pজ)
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "চেষ্টা")) {
        খাও_কীওয়ার্ড(p, "চেষ্টা")
        ধরি body = পার্স_ব্লক(p)
        ধরি err_var = প্রত্যাশিত_আইডি(p, "এরর ভ্যারিয়েবল")
        ধরি handler = পার্স_ব্লক(p)
        স্টেট_শেষ(p)
        রিটার্ন চেষ্টা_স্ট(চেষ্টা_স্ট্যাট(body, err_var, handler))
    }
    
    যদি (এ_কীওয়ার্ড_কি(p, "ডিসপ্লে")) {
        খাও_কীওয়ার্ড(p, "ডিসপ্লে")
        ধরি body = পার্স_ব্লক(p)
        স্টেট_শেষ(p)
        রিটার্ন ডিসপ্লে_স্ট(body)
    }
    
    যদি (এ_চিহ্ন_কি(p, "{")) {
        রিটার্ন নেস্টেড_স্ট(পার্স_ব্লক(p))
    }
    
    // মিলাও এক্সপ্রেশন
    যদি (এ_কীওয়ার্ড_কি(p, "মিলাও")) {
        খাও_কীওয়ার্ড(p, "মিলাও")
        ধরি scrut = পার্স_এক্সপ্র(p)
        ধরি arms: ম্যাচ_আর্ম[] = []
        প্রত্যাশিত_চিহ্ন(p, "{")
        এড়িয়ে_যাও_নতুনলাইন(p)
        যতক্ষণ (না এ_চিহ্ন_কি(p, "}")) {
            ধরি pat = পার্স_প্যাটার্ন(p)
            প্রত্যাশিত_চিহ্ন(p, "=>")
            ধরি arm_body = পার্স_এক্সপ্র(p)
            যোগ_করো(arms, ম্যাচ_আর্ম(pat, arm_body))
            স্টেট_শেষ(p)
            এড়িয়ে_যাও_নতুনলাইন(p)
        }
        প্রত্যাশিত_চিহ্ন(p, "}")
        স্টেট_শেষ(p)
        রিটার্ন এক্সপ্র_স্ট(এক্সপ্র(ম্যাচ_এক(ম্যাচ_এক্সপ্র(pজ, শেয়ার_করো(scrut), arms)), pজ))
    }
    
    // ডিফল্ট: এক্সপ্রেশন স্টেটমেন্ট
    ধরি e = পার্স_এক্সপ্র(p)
    স্টেট_শেষ(p)
    রিটার্ন এক্সপ্র_স্ট(e)
}

ফাংশন পার্স_যদি(পার্সার p) -> ইফ_স্ট্যাট {
    ধরি pজ = বর্তমান_পজ(p)
    খাও_কীওয়ার্ড(p, "যদি")
    প্রত্যাশিত_চিহ্ন(p, "(")
    ধরি cond = পার্স_এক্সপ্র(p)
    প্রত্যাশিত_চিহ্ন(p, ")")
    ধরি then_block = পার্স_ব্লক(p)
    ধরি els: বিকল্প<এলস_শাখা> = খালি_বি()
    
    যদি (খাও_কীওয়ার্ড(p, "নাহলে")) {
        যদি (এ_কীওয়ার্ড_কি(p, "যদি")) {
            els = কিছু_বি(ইফ_এল(শেয়ার_করো(পার্স_যদি(p))))
        } নাহলে যদি (এ_চিহ্ন_কি(p, "{")) {
            els = কিছু_বি(ব্লক_এল(পার্স_ব্লক(p)))
        } নাহলে {
            ডায়াগ_এখানে(p, "'নাহলে'-এর পরে 'যদি' বা '{' প্রত্যাশিত")
        }
    }
    
    রিটার্ন ইফ_স্ট্যাট(pজ, cond, then_block, els)
}

ফাংশন পার্স_প্যাটার্ন(পার্সার p) -> প্যাটার্ন {
    ধরি pজ = বর্তমান_পজ(p)
    
    যদি (এ_চিহ্ন_কি(p, "_")) {
        কার্সর_এগোও(p)
        রিটার্ন ওয়াইল্ডকার্ড_প্যা(pজ)
    }
    
    যদি (এ_নাম_কি(p)) {
        ধরি var_name = বর্তমান_নাম(p)
        কার্সর_এগোও(p)
        ধরি args: আইডি[] = []
        যদি (এ_চিহ্ন_কি(p, "(")) {
            কার্সর_এগোও(p)
            যদি (না এ_চিহ্ন_কি(p, ")")) {
                ধরি আরও = সত্য
                যতক্ষণ (আরও) {
                    যোগ_করো(args, প্রত্যাশিত_আইডি(p, "প্যাটার্ন আর্গুমেন্ট"))
                    যদি (না খাও_চিহ্ন(p, ",")) {
                        আরও = মিথ্যা
                    }
                }
            }
            প্রত্যাশিত_চিহ্ন(p, ")")
        }
        রিটার্ন ভ্যারিয়েন্ট_প্যা(আইডি(var_name, pজ), args, pজ)
    }
    
    ডায়াগ_এখানে(p, "প্যাটার্ন প্রত্যাশিত")
    রিটার্ন ওয়াইল্ডকার্ড_প্যা(pজ)
}
