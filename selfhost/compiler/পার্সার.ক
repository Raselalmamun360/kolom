}

// এক-টোকেন লুকঅ্যাহেড — শুধু `টাইপ[]` প্যাটার্নের জন্য, যেখানে `[`-এর
// পরপরই `]` লাগবে (ইনডেক্স-এক্সপ্রেশনের `[`-থেকে আলাদা করতে, যেমন
// রেফারেন্সের `parse_type`)।
ফাংশন পরের_চিহ্ন_কি(পার্সার p, লেখা s) -> বুলিয়ান {
    ধরি j = p.সূচক + ১
    যদি (j >= দৈর্ঘ্য(p.টোকেনগুলো)) {
        রিটার্ন মিথ্যা
    }
    রিটার্ন মিলাও p.টোকেনগুলো[j].ধরন {
        চিহ্ন_টো(o) => o == s,
        নাম_টো(x) => মিথ্যা,
        কীওয়ার্ড_টো(x) => মিথ্যা,
        সংখ্যা_টো(x) => মিথ্যা,
        লেখা_টো(x) => মিথ্যা,
        অক্ষর_টো(x) => মিথ্যা,
        নতুনলাইন_টো => মিথ্যা,
    }
}

// --- টাইপ ---
// রেফারেন্সের `parse_type`/`parse_type_base`।

ফাংশন পার্স_টাইপ_ভিত্তি_শেয়ার_সহ(পার্সার p) -> টাইপ_এক্সপ্র {
    যদি (এ_কীওয়ার্ড_কি(p, "শেয়ার")) {
        কার্সর_এগোও(p)
        রিটার্ন শেয়ার_টে(শেয়ার_করো(পার্স_টাইপ_বেস(p)))
    }
    রিটার্ন পার্স_টাইপ_বেস(p)
}

ফাংশন পার্স_টাইপ(পার্সার p) -> টাইপ_এক্সপ্র {
    ধরি ty = পার্স_টাইপ_ভিত্তি_শেয়ার_সহ(p)
    ধরি থামো = মিথ্যা
    যতক্ষণ (না থামো) {
        যদি (এ_চিহ্ন_কি(p, "[") এবং পরের_চিহ্ন_কি(p, "]")) {
            কার্সর_এগোও(p)
            কার্সর_এগোও(p)
            ty = অ্যারে_টে(শেয়ার_করো(ty))
        } নাহলে {
            থামো = সত্য
        }
    }
    রিটার্ন ty
}

ফাংশন পার্স_টাইপ_বেস(পার্সার p) -> টাইপ_এক্সপ্র {
    ধরি pজ = বর্তমান_পজ(p)

    যদি (এ_চিহ্ন_কি(p, "(")) {
        কার্সর_এগোও(p)
        ধরি প্যারামগুলো: টাইপ_এক্সপ্র[] = []
        যদি (না এ_চিহ্ন_কি(p, ")")) {
            ধরি আরও = সত্য
            যতক্ষণ (আরও) {
                যোগ_করো(প্যারামগুলো, পার্স_টাইপ(p))
                যদি (না খাও_চিহ্ন(p, ",")) {
                    আরও = মিথ্যা
                }
            }
        }
        প্রত্যাশিত_চিহ্ন(p, ")")
        যদি (না এ_চিহ্ন_কি(p, "->")) {
            ডায়াগ_এখানে(p, "'->' প্রত্যাশিত — ফাংশন-টাইপে রিটার্ন টাইপ আবশ্যক")
        }
        খাও_চিহ্ন(p, "->")
        ধরি ret = পার্স_টাইপ(p)
        রিটার্ন ফাংশন_টে(প্যারামগুলো, শেয়ার_করো(ret))
    }

    ধরি কী = বর্তমান_কীওয়ার্ড(p)
    যদি (কী == "ম্যাপ") {
        কার্সর_এগোও(p)
        যদি (না প্রত্যাশিত_চিহ্ন(p, "[")) {
            রিটার্ন নাম_টে(আইডি("ম্যাপ", pজ))
        }
        ধরি কী_টাইপ = পার্স_টাইপ(p)
        যদি (না প্রত্যাশিত_চিহ্ন(p, ",")) {
            রিটার্ন নাম_টে(আইডি("ম্যাপ", pজ))
        }
        ধরি মান_টাইপ = পার্স_টাইপ(p)
        প্রত্যাশিত_চিহ্ন(p, "]")
        রিটার্ন ম্যাপ_টে(শেয়ার_করো(কী_টাইপ), শেয়ার_করো(মান_টাইপ))
    }
    যদি (দৈর্ঘ্য(কী) > ০ এবং প্রিমিটিভ_টাইপ_কিনা(কী)) {
        কার্সর_এগোও(p)
        রিটার্ন নাম_টে(আইডি(কী, pজ))
    }
    যদি (এ_নাম_কি(p)) {
        ধরি নাম = বর্তমান_নাম(p)
        কার্সর_এগোও(p)
        যদি (এ_চিহ্ন_কি(p, "<")) {
            কার্সর_এগোও(p)
            ধরি আর্গগুলো: টাইপ_এক্সপ্র[] = []
            যদি (না এ_চিহ্ন_কি(p, ">")) {
                ধরি আরও২ = সত্য
                যতক্ষণ (আরও২) {
                    যোগ_করো(আর্গগুলো, পার্স_টাইপ(p))
                    যদি (না খাও_চিহ্ন(p, ",")) {
                        আরও২ = মিথ্যা
                    }
                }
            }
            প্রত্যাশিত_চিহ্ন(p, ">")
            রিটার্ন জেনেরিক_টে(আইডি(নাম, pজ), আর্গগুলো)
        }
        রিটার্ন নাম_টে(আইডি(নাম, pজ))
    }
    ডায়াগ_এখানে(p, "টাইপ প্রত্যাশিত")
    যদি (বাকি_আছে(p)) {
        কার্সর_এগোও(p)
    }
    রিটার্ন নাম_টে(আইডি("ত্রুটি", pজ))
}

// রেফারেন্সের `parse_type_params` — `তথ্য`/`এনাম`/`ফাংশন`-এর নামের পরে
// ঐচ্ছিক `<T, ...>`। কোনো `<` না থাকলে খালি অ্যারে (ত্রুটি না) — জেনেরিক্স
// অপ্ট-ইন।
ফাংশন পার্স_টাইপ_প্যারাম(পার্সার p) -> আইডি[] {
    ধরি প্যারামগুলো: আইডি[] = []
    যদি (না খাও_চিহ্ন(p, "<")) {
        রিটার্ন প্যারামগুলো
    }
    যদি (না এ_চিহ্ন_কি(p, ">")) {
        ধরি আরও = সত্য
        যতক্ষণ (আরও) {
            ধরি নাম = প্রত্যাশিত_আইডি(p, "টাইপ-প্যারামিটারের নাম")
            যোগ_করো(প্যারামগুলো, নাম)
            যদি (না খাও_চিহ্ন(p, ",")) {
                আরও = মিথ্যা
            }
        }
    }
    প্রত্যাশিত_চিহ্ন(p, ">")
    রিটার্ন প্যারামগুলো
}
