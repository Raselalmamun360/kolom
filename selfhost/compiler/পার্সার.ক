ফাংশন পার্সার_বানাও(টোকেন[] টোকেনগুলো) -> পার্সার {
    ধরি ত্রু: ডায়াগনস্টিক[] = []
    রিটার্ন পার্সার(টোকেনগুলো, ০, ত্রু, ০, ০, ০)
}

// --- কার্সর ---

ফাংশন বাকি_আছে(পার্সার p) -> বুলিয়ান {
    রিটার্ন p.সূচক < দৈর্ঘ্য(p.টোকেনগুলো)
}

ফাংশন কার্সর_এগোও(পার্সার p) -> ফাঁকা {
    যদি (বাকি_আছে(p)) {
        p.সূচক = p.সূচক + ১
    }
}

// রেফারেন্সের `pos()` — বর্তমান টোকেনের অবস্থান, স্ট্রিম শেষ হয়ে গেলে শেষ টোকেনের
// অবস্থান, স্ট্রিম খালি হলে (১,১)।
ফাংশন বর্তমান_পজ(পার্সার p) -> পজ {
    যদি (বাকি_আছে(p)) {
        ধরি t = p.টোকেনগুলো[p.সূচক]
        রিটার্ন পজ(t.লাইন, t.কলাম)
    }
    যদি (দৈর্ঘ্য(p.টোকেনগুলো) > ০) {
        ধরি শেষ = p.টোকেনগুলো[দৈর্ঘ্য(p.টোকেনগুলো) - ১]
        রিটার্ন পজ(শেষ.লাইন, শেষ.কলাম)
    }
    রিটার্ন পজ(১, ১)
}

// বর্তমান টোকেনের KW/OP পেলোড টেক্সট — নেই হলে খালি স্ট্রিং। বিশুদ্ধ নিষ্কাশন, তাই মিলাও।
ফাংশন বর্তমান_কীওয়ার্ড(পার্সার p) -> লেখা {
    যদি (না বাকি_আছে(p)) {
        রিটার্ন ""
    }
    রিটার্ন মিলাও p.টোকেনগুলো[p.সূচক].ধরন {
        কীওয়ার্ড_টো(k) => k,
        নাম_টো(_) => "",
        সংখ্যা_টো(_) => "",
        লেখা_টো(_) => "",
        অক্ষর_টো(_) => "",
        নতুনলাইন_টো => "",
        চিহ্ন_টো(_) => "",
    }
}

ফাংশন বর্তমান_চিহ্ন(পার্সার p) -> লেখা {
    যদি (না বাকি_আছে(p)) {
        রিটার্ন ""
    }
    রিটার্ন মিলাও p.টোকেনগুলো[p.সূচক].ধরন {
        চিহ্ন_টো(o) => o,
        নাম_টো(_) => "",
        কীওয়ার্ড_টো(_) => "",
        সংখ্যা_টো(_) => "",
        লেখা_টো(_) => "",
        অক্ষর_টো(_) => "",
        নতুনলাইন_টো => "",
    }
}

ফাংশন বর্তমান_নাম(পার্সার p) -> লেখা {
    যদি (না বাকি_আছে(p)) {
        রিটার্ন ""
    }
    রিটার্ন মিলাও p.টোকেনগুলো[p.সূচক].ধরন {
        নাম_টো(s) => s,
        কীওয়ার্ড_টো(_) => "",
        সংখ্যা_টো(_) => "",
        লেখা_টো(_) => "",
        অক্ষর_টো(_) => "",
        নতুনলাইন_টো => "",
        চিহ্ন_টো(_) => "",
    }
}

ফাংশন এ_চিহ্ন_কি(পার্সার p, লেখা s) -> বুলিয়ান {
    রিটার্ন বর্তমান_চিহ্ন(p) == s
}

ফাংশন এ_কীওয়ার্ড_কি(পার্সার p, লেখা s) -> বুলিয়ান {
    রিটার্ন বর্তমান_কীওয়ার্ড(p) == s
}

ফাংশন এ_নতুনলাইন_কি(পার্সার p) -> বুলিয়ান {
    যদি (না বাকি_আছে(p)) {
        রিটার্ন মিথ্যা
    }
    রিটার্ন মিলাও p.টোকেনগুলো[p.সূচক].ধরন {
        নতুনলাইন_টো => সত্য,
        নাম_টো(_) => মিথ্যা,
        কীওয়ার্ড_টো(_) => মিথ্যা,
        সংখ্যা_টো(_) => মিথ্যা,
        লেখা_টো(_) => মিথ্যা,
        অক্ষর_টো(_) => মিথ্যা,
        চিহ্ন_টো(_) => মিথ্যা,
    }
}

ফাংশন খাও_চিহ্ন(পার্সার p, লেখা s) -> বুলিয়ান {
    যদি (এ_চিহ্ন_কি(p, s)) {
        কার্সর_এগোও(p)
        রিটার্ন সত্য
    }
    রিটার্ন মিথ্যা
}

ফাংশন খাও_কীওয়ার্ড(পার্সার p, লেখা s) -> বুলিয়ান {
    যদি (এ_কীওয়ার্ড_কি(p, s)) {
        কার্সর_এগোও(p)
        রিটার্ন সত্য
    }
    রিটার্ন মিথ্যা
}

ফাংশন ডায়াগ_এখানে(পার্সার p, লেখা বার্তা) -> ফাঁকা {
    ধরি ps = বর্তমান_পজ(p)
    যোগ_করো(p.ত্রুটিগুলো, ডায়াগনস্টিক(ps.লাইন, ps.কলাম, বার্তা))
}

ফাংশন প্রত্যাশিত_চিহ্ন(পার্সার p, লেখা s) -> বুলিয়ান {
    যদি (খাও_চিহ্ন(p, s)) {
        রিটার্ন সত্য
    }
    ডায়াগ_এখানে(p, "'" + s + "' প্রত্যাশিত")
    রিটার্ন মিথ্যা
}

// প্রিমিটিভ-টাইপ কীওয়ার্ড — `expect_module_name`/`member_keyword`-এর PRIMITIVE_TYPES।
ফাংশন প্রিমিটিভ_টাইপ_কিনা(লেখা s) -> বুলিয়ান {
    যদি (s == "সংখ্যা") {
        রিটার্ন সত্য
    }
    যদি (s == "দশমিক") {
        রিটার্ন সত্য
    }
    যদি (s == "লেখা") {
        রিটার্ন সত্য
    }
    যদি (s == "বুলিয়ান") {
        রিটার্ন সত্য
    }
    যদি (s == "অক্ষর") {
        রিটার্ন সত্য
    }
    রিটার্ন s == "ফাঁকা"
}

// রেফারেন্সের `member_keyword` — মেম্বার-পজিশনে (ইম্পোর্টের পরে, `তথ্য`-র ফিল্ড-নাম,
// `.`-এর পরে) একটা প্রিমিটিভ-টাইপ কীওয়ার্ড শুধু নাম, টাইপ না (v2-prerequisites.md
// §৬-এর ফিক্স)। বর্তমান টোকেন সেরকম হলে এগিয়ে গিয়ে আইডি বানায়, নইলে নাই।
ফাংশন মেম্বার_কীওয়ার্ড(পার্সার p) -> বিকল্প<আইডি> {
    ধরি k = বর্তমান_কীওয়ার্ড(p)
    যদি (দৈর্ঘ্য(k) > ০ এবং প্রিমিটিভ_টাইপ_কিনা(k)) {
        ধরি ps = বর্তমান_পজ(p)
        কার্সর_এগোও(p)
        রিটার্ন কিছু_বি(আইডি(k, ps))
    }
    রিটার্ন খালি_বি()
}

// রেফারেন্সের `expect_ident` — নাম-টোকেন প্রত্যাশা করে; না পেলে ডায়াগনস্টিক দিয়ে একটা
// প্লেসহোল্ডার আইডি ("ত্রুটি") ফেরত দেয়, যেমন রেফারেন্সের কলাররা
// `.unwrap_or_else(...)` দিয়ে করে — কলমে `Option<T>` থ্রেড করার `?` নেই, তাই প্রতিটা
// এক্সপেক্ট-ফাংশন সবসময় একটা ব্যবহারযোগ্য মান ফেরত দেয়, কখনো "কিছু না" নয়।
ফাংশন প্রত্যাশিত_আইডি(পার্সার p, লেখা কী) -> আইডি {
    ধরি n = বর্তমান_নাম(p)
    যদি (দৈর্ঘ্য(n) > ০) {
        ধরি ps = বর্তমান_পজ(p)
        কার্সর_এগোও(p)
        রিটার্ন আইডি(n, ps)
    }
    ডায়াগ_এখানে(p, কী + " প্রত্যাশিত")
    রিটার্ন আইডি("ত্রুটি", বর্তমান_পজ(p))
}

// রেফারেন্সের `expect_member_name` — `expect_ident`-এর মতোই, কিন্তু আগে
// `member_keyword` চেষ্টা করে।
ফাংশন প্রত্যাশিত_মেম্বার_নাম(পার্সার p, লেখা কী) -> আইডি {
    ধরি mk = মেম্বার_কীওয়ার্ড(p)
    রিটার্ন মিলাও mk {
        কিছু_বি(id) => id,
        খালি_বি => প্রত্যাশিত_আইডি(p, কী),
    }
}

// রেফারেন্সের `expect_module_name` — `expect_member_name`-এর ডাক-নাম, `ইম্পোর্ট`-এর
// পরে ব্যবহৃত (`ইম্পোর্ট লেখা` বৈধ হতে হবে)।
ফাংশন প্রত্যাশিত_মডিউল_নাম(পার্সার p) -> আইডি {
    রিটার্ন প্রত্যাশিত_মেম্বার_নাম(p, "'ইম্পোর্ট'-এর পরে মডিউলের নাম")
}

ফাংশন এড়িয়ে_যাও_নতুনলাইন(পার্সার p) -> ফাঁকা {
    যতক্ষণ (এ_নতুনলাইন_কি(p)) {
        কার্সর_এগোও(p)
    }
}

// রেফারেন্সের `SYNC_KEYWORDS` — এরর-রিকভারিতে যেখানে থামা নিরাপদ।
ফাংশন সিঙ্ক_কীওয়ার্ড_কিনা(লেখা k) -> বুলিয়ান {
    যদি (k == "অ্যাপ") {
        রিটার্ন সত্য
    }
    যদি (k == "ফাংশন") {
        রিটার্ন সত্য
    }
    যদি (k == "ধরি") {
        রিটার্ন সত্য
    }
    যদি (k == "ধ্রুবক") {
        রিটার্ন সত্য
    }
    রিটার্ন k == "ইম্পোর্ট"
}

// একটা ব্যর্থ স্টেটমেন্টের বাকি অংশ ছেড়ে দিয়ে পরের নিরাপদ বিন্দুতে যায় — `}`, EOF,
// একটা নতুনলাইন, বা একটা sync কীওয়ার্ড পর্যন্ত।
ফাংশন রিকভার_স্টেট(পার্সার p) -> ফাঁকা {
    ধরি থামো = মিথ্যা
    যতক্ষণ (না থামো) {
        যদি (না বাকি_আছে(p)) {
            থামো = সত্য
        } নাহলে যদি (এ_চিহ্ন_কি(p, "}")) {
            থামো = সত্য
        } নাহলে যদি (এ_নতুনলাইন_কি(p)) {
            কার্সর_এগোও(p)
            থামো = সত্য
        } নাহলে যদি (সিঙ্ক_কীওয়ার্ড_কিনা(বর্তমান_কীওয়ার্ড(p))) {
            থামো = সত্য
        } নাহলে {
            কার্সর_এগোও(p)
        }
    }
}

ফাংশন রিকভার_শীর্ষ(পার্সার p) -> ফাঁকা {
    ধরি থামো = মিথ্যা
    যতক্ষণ (না থামো) {
        যদি (না বাকি_আছে(p)) {
            থামো = সত্য
        } নাহলে যদি (সিঙ্ক_কীওয়ার্ড_কিনা(বর্তমান_কীওয়ার্ড(p))) {
            থামো = সত্য
        } নাহলে {
            কার্সর_এগোও(p)
        }
    }
}

// নতুনলাইন বা `}`/EOF-এ পৌঁছানো — খায়, বা এমনিতেই সেখানে থাকলে সত্য দেয়।
ফাংশন খাও_নতুনলাইন_বা_বন্ধ(পার্সার p) -> বুলিয়ান {
    যদি (এ_নতুনলাইন_কি(p)) {
        কার্সর_এগোও(p)
        রিটার্ন সত্য
    }
    রিটার্ন না বাকি_আছে(p) অথবা এ_চিহ্ন_কি(p, "}")
}

ফাংশন স্টেট_শেষ(পার্সার p) -> ফাঁকা {
    যদি (খাও_নতুনলাইন_বা_বন্ধ(p)) {
        রিটার্ন ফাঁকা
    }
    ডায়াগ_এখানে(p, "স্টেটমেন্ট শেষে নতুন লাইন প্রত্যাশিত")
    রিকভার_স্টেট(p)
}

// --- অতিরিক্ত টোকেন-এক্সট্র্যাকশন ---
// `বর্তমান_কীওয়ার্ড`/`বর্তমান_চিহ্ন`/`বর্তমান_নাম`-এর খালি-স্ট্রিং-মানে-নেই
// কৌশলটা এখানে কাজ করে না — লেখা-লিটারেল খালি হতে পারে (`""`), আর অক্ষরের
