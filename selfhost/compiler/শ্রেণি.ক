// ক্যারেক্টার ক্লাসিফিকেশন — `kolom-lexer/src/lib.rs`-এর
// `is_bangla_digit`/`is_bangla_block`/`is_ident_start`/`is_ident_part`/
// `is_any_digit`/`digit_value`/`digit_to_ascii`-এর হুবহু প্রতিরূপ।
//
// রেঞ্জগুলো ইচ্ছাকৃতভাবে হুবহু কপি করা — পোর্ট করার সময় আচরণ "উন্নত"
// করা হয় না (self-hosting-plan.md §৯)।

ফাংশন বাংলা_অঙ্ক_কিনা(অক্ষর c) -> বুলিয়ান {
    রিটার্ন c >= '\u{09E6}' এবং c <= '\u{09EF}'
}

ফাংশন বাংলা_ব্লক_কিনা(অক্ষর c) -> বুলিয়ান {
    রিটার্ন c >= '\u{0980}' এবং c <= '\u{09FF}'
}

ফাংশন ascii_অঙ্ক_কিনা(অক্ষর c) -> বুলিয়ান {
    রিটার্ন c >= '0' এবং c <= '9'
}

ফাংশন যেকোনো_অঙ্ক_কিনা(অক্ষর c) -> বুলিয়ান {
    রিটার্ন ascii_অঙ্ক_কিনা(c) অথবা বাংলা_অঙ্ক_কিনা(c)
}

// Rust-এ `c.is_alphabetic()` — পুরো ইউনিকোডের Alphabetic প্রপার্টি। কলমে
// সেই প্রেডিকেট নেই, তাই বাস্তবে কলম-সোর্সে যা দেখা যায় সেটুকুই ধরা হলো:
// ASCII অক্ষর, `_`, আর বাংলা ব্লকের *অক্ষর* অংশ।
//
// বাংলা ব্লক থেকে দুটো টুকরো বাদ — অঙ্ক (U+09E6–U+09EF) আর মুদ্রা/চিহ্নের
// লেজ (U+09F2–U+09FF)। এগুলো Alphabetic নয়, তাই আইডেন্টিফায়ার *শুরু*
// করতে পারে না: `৭ক` রেফারেন্স লেক্সারে সংখ্যা `৭` তারপর নাম `ক`, একটা
// আইডেন্টিফায়ার নয়। (`নাম_অংশ_কিনা` পুরো ব্লকটাই মানে — রেফারেন্সের
// `is_ident_part`-ও তাই করে, তাই সেখানে এই বাদটা লাগে না।)
//
// এটা এখনো একটা আসন্ন-মান: বাংলা ব্লকের বাইরের কোনো Alphabetic অক্ষর
// (দেবনাগরী, উচ্চারণ-চিহ্নযুক্ত ল্যাটিন) এখানে ধরা পড়বে না। M2-এর
// ডিফারেনশিয়াল কর্পাস এমন কিছু ধরলে ঠিক এখানেই ঠিক করতে হবে।
ফাংশন নাম_শুরু_কিনা(অক্ষর c) -> বুলিয়ান {
    যদি (c == '_') { রিটার্ন সত্য }
    যদি (c >= 'a' এবং c <= 'z') { রিটার্ন সত্য }
    যদি (c >= 'A' এবং c <= 'Z') { রিটার্ন সত্য }
    যদি (না বাংলা_ব্লক_কিনা(c)) { রিটার্ন মিথ্যা }
    যদি (বাংলা_অঙ্ক_কিনা(c)) { রিটার্ন মিথ্যা }
    রিটার্ন c < '\u{09F2}'
}

// ZWNJ (U+200C) ও ZWJ (U+200D) — বাংলা যুক্তাক্ষর নিয়ন্ত্রণে ব্যবহৃত,
// তাই আইডেন্টিফায়ারের ভেতরে বৈধ।
ফাংশন নাম_অংশ_কিনা(অক্ষর c) -> বুলিয়ান {
    যদি (নাম_শুরু_কিনা(c)) { রিটার্ন সত্য }
    যদি (যেকোনো_অঙ্ক_কিনা(c)) { রিটার্ন সত্য }
    রিটার্ন c == '\u{200C}' অথবা c == '\u{200D}'
}

ফাংশন অঙ্কের_মান(অক্ষর c) -> সংখ্যা {
    যদি (ascii_অঙ্ক_কিনা(c)) {
        রিটার্ন সংখ্যায়(লেখায়(c))
    }
    // বাংলা অঙ্ক: '০' থেকে দূরত্ব। কলমে অক্ষর→কোডপয়েন্ট রূপান্তর নেই,
    // তাই তুলনা করে বের করা হয় — দশটা ধাপ, ধ্রুবক খরচ।
    যদি (c == '০') { রিটার্ন ০ }
    যদি (c == '১') { রিটার্ন ১ }
    যদি (c == '২') { রিটার্ন ২ }
    যদি (c == '৩') { রিটার্ন ৩ }
    যদি (c == '৪') { রিটার্ন ৪ }
    যদি (c == '৫') { রিটার্ন ৫ }
    যদি (c == '৬') { রিটার্ন ৬ }
    যদি (c == '৭') { রিটার্ন ৭ }
    যদি (c == '৮') { রিটার্ন ৮ }
    রিটার্ন ৯
}

ফাংশন অঙ্ক_ascii_তে(অক্ষর c) -> লেখা {
    যদি (বাংলা_অঙ্ক_কিনা(c)) {
        রিটার্ন লেখায়(অঙ্কের_মান(c))
    }
    রিটার্ন লেখায়(c)
}
