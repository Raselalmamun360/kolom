ইম্পোর্ট টোকেন

অ্যাপ {
    ধরি t = টোকেন(কীওয়ার্ড_টো("ধরি"), ১, ১)
    ধরি d = ডায়াগনস্টিক(২, ৫, "পরীক্ষা")
    ধরি n = সংখ্যা_টো(পূর্ণ_টো(৪২))
    লেখো(লেখায়(t.লাইন) + ":" + লেখায়(t.কলাম))
    লেখো(d.বার্তা)
    লেখো(মিলাও n {
        নাম_টো(s) => s,
        কীওয়ার্ড_টো(s) => s,
        সংখ্যা_টো(v) => মিলাও v { পূর্ণ_টো(x) => লেখায়(x), ভগ্ন_টো(y) => লেখায়(y), },
        লেখা_টো(s) => s,
        অক্ষর_টো(c) => লেখায়(c),
        নতুনলাইন_টো => "\n",
        চিহ্ন_টো(o) => o,
    })
}
