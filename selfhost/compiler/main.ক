// M2 ড্রাইভার — একটা ফাইল লেক্স করে `kolom lex --stable`-এর হুবহু
// ফরম্যাটে ডাম্প দেয়, যাতে `scripts/diff-dump-selfhost.sh` এই সেলফ-হোস্টেড
// লেক্সার আর রেফারেন্স লেক্সার দুটোর আউটপুট বাইট-বাই-বাইট মিলিয়ে দেখতে
// পারে।
//
// ফরম্যাট (crates/kolom-cli/src/main.rs-এর stable_token_line/stable_escape
// দেখুন) — প্রতিটা টোকেন এক লাইনে, ট্যাব দিয়ে ভাগ করা চারটা ফিল্ড:
//
//     লাইন\tকলাম\tKIND\tপেলোড
//
// KIND-এর মান: IDENT, KW, INT, FLOAT, STR, CHR, NL, OP। NL-এর পেলোড খালি।
// ডায়াগনস্টিক আলাদা লাইনে: `ERR\tলাইন\tকলাম\tবার্তা`।
//
// পেলোড-এস্কেপিং ইচ্ছাকৃতভাবে ন্যূনতম — Rust-এর `{:?}` ব্যবহার করা হয়নি,
// কারণ সেটা `char::is_printable` দিয়ে এস্কেপ করে, যেটা বাংলা যুক্তচিহ্নকে
// "অপ্রিন্টেবল" ধরে (`অ্যাপ` তখন `"অ\u{9cd}য\u{9be}প"` হয়ে যায়) — সেই
// টেবিলটা কলমে বহন করা মানে Rust-এর একটা ইমপ্লিমেন্টেশন-বিস্তারিত জিনিস
// সেলফ-হোস্টেড কম্পাইলারে স্থায়ীভাবে গেঁথে দেওয়া, আর তখন এই ডাম্প লেক্সিং
// নয়, ফরম্যাটিং টেস্ট করত। তার বদলে শুধু চারটা জিনিস এস্কেপ হয় —
// ব্যাকস্ল্যাশ, তিনটা whitespace ক্যারেক্টার যা লাইন/ফিল্ড গঠন ভাঙত, আর
// C0/DEL — বাকি সব, বাংলা-সহ, লিটারেল UTF-8 থাকে।

ইম্পোর্ট লেক্সার
ইম্পোর্ট টোকেন
ইম্পোর্ট লেখা
ইম্পোর্ট ফাইল
ইম্পোর্ট সিস্টেম

ফাংশন হেক্স_অঙ্ক(সংখ্যা v) -> অক্ষর {
    যদি (v < ১০) {
        রিটার্ন অক্ষরে(v + কোডে('0'))
    }
    রিটার্ন অক্ষরে(v - ১০ + কোডে('a'))
}

// দশমিক নয়, ষোলো-ভিত্তিক — `\u{...}`-এর জন্য। `n == ০`-এর বিশেষ কেস
// লাগে, কারণ নিচের লুপ ০-এর জন্য শূন্যবার চলত।
ফাংশন হেক্সে(সংখ্যা n) -> লেখা {
    যদি (n == ০) {
        রিটার্ন "0"
    }
    ধরি s = ""
    ধরি v = n
    যতক্ষণ (v > ০) {
        s = লেখায়(হেক্স_অঙ্ক(v % ১৬)) + s
        v = v / ১৬
    }
    রিটার্ন s
}

ফাংশন স্টেবল_এস্কেপ(লেখা s) -> লেখা {
    ধরি আউট = ""
    ধরি i = ০
    ধরি n = দৈর্ঘ্য(s)
    যতক্ষণ (i < n) {
        ধরি c = s[i]
        যদি (c == '\\') {
            আউট = আউট + "\\\\"
        } নাহলে যদি (c == '\t') {
            আউট = আউট + "\\t"
        } নাহলে যদি (c == '\n') {
            আউট = আউট + "\\n"
        } নাহলে যদি (c == '\r') {
            আউট = আউট + "\\r"
        } নাহলে যদি (কোডে(c) < ৩২ অথবা কোডে(c) == ১২৭) {
            আউট = আউট + "\\u{" + হেক্সে(কোডে(c)) + "}"
        } নাহলে {
            আউট = আউট + লেখায়(c)
        }
        i = i + ১
    }
    রিটার্ন আউট
}

// মিলাও-এর প্রতিটা শাখা একটামাত্র এক্সপ্রেশন — কলমে ব্লক-এক্সপ্রেশন নেই,
// তাই "কাইন্ড ঠিক করি, তারপর পেলোড ঠিক করি" এই দুই-ধাপ পদ্ধতি চলে না।
// তার বদলে প্রতিটা শাখাই সরাসরি সম্পূর্ণ লাইনটা বানিয়ে ফেরত দেয়।
ফাংশন স্টেবল_টোকেন_লাইন(টোকেন t) -> লেখা {
    ধরি আগে = লেখায়(t.লাইন) + "\t" + লেখায়(t.কলাম) + "\t"
    রিটার্ন মিলাও t.ধরন {
        নাম_টো(s) => আগে + "IDENT\t" + স্টেবল_এস্কেপ(s),
        কীওয়ার্ড_টো(s) => আগে + "KW\t" + স্টেবল_এস্কেপ(s),
        সংখ্যা_টো(v) => মিলাও v {
            পূর্ণ_টো(x) => আগে + "INT\t" + লেখায়(x),
            ভগ্ন_টো(y) => আগে + "FLOAT\t" + লেখায়(y),
        },
        লেখা_টো(s) => আগে + "STR\t" + স্টেবল_এস্কেপ(s),
        অক্ষর_টো(c) => আগে + "CHR\t" + স্টেবল_এস্কেপ(লেখায়(c)),
        নতুনলাইন_টো => আগে + "NL\t",
        চিহ্ন_টো(o) => আগে + "OP\t" + স্টেবল_এস্কেপ(o),
    }
}

ফাংশন ডাম্প_স্টেবল(লেখা উৎস) -> ফাঁকা {
    ধরি l = লেক্স(উৎস)
    প্রতি (t : l.টোকেনগুলো) {
        লেখো(স্টেবল_টোকেন_লাইন(t))
    }
    প্রতি (d : l.ত্রুটিগুলো) {
        লেখো("ERR\t" + লেখায়(d.লাইন) + "\t" + লেখায়(d.কলাম) + "\t" + স্টেবল_এস্কেপ(d.বার্তা))
    }
}

অ্যাপ {
    ধরি আর্গ = সিস্টেম.আর্গুমেন্ট()
    যদি (দৈর্ঘ্য(আর্গ) == ০) {
        লেখো("ব্যবহার: kolom চালাও selfhost/compiler/main.ক <ফাইল>")
    } নাহলে {
        ধরি উৎস = ফাইল.পড়ো(আর্গ[০])
        ডাম্প_স্টেবল(উৎস)
    }
}
