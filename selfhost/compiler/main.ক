//
// M2-এ এটাই CLI হবে: ফাইল পড়বে আর `kolom lex`-এর হুবহু ফরম্যাটে ডাম্প
// দেবে, যাতে `scripts/diff-dump.sh` দুই ইমপ্লিমেন্টেশন মেলাতে পারে।
// এখানকার ফরম্যাটটা পড়ার জন্য, মেলানোর জন্য নয়।

ইম্পোর্ট লেক্সার
ইম্পোর্ট টোকেন

ফাংশন ধরন_দেখাও(টোকেন_ধরন k) -> লেখা {
    রিটার্ন মিলাও k {
        নাম_টো(s) => "Ident(" + s + ")",
        কীওয়ার্ড_টো(s) => "Kw(" + s + ")",
        সংখ্যা_টো(v) => মিলাও v {
            পূর্ণ_টো(x) => "Num(Int(" + লেখায়(x) + "))",
            ভগ্ন_টো(y) => "Num(Float(" + লেখায়(y) + "))",
        },
        লেখা_টো(s) => "Str(" + s + ")",
        অক্ষর_টো(c) => "Chr(" + লেখায়(c) + ")",
        নতুনলাইন_টো => "Newline",
        চিহ্ন_টো(o) => "Op(" + o + ")",
    }
}

ফাংশন ডাম্প(লেখা উৎস) -> ফাঁকা {
    ধরি l = লেক্স(উৎস)
    প্রতি (t : l.টোকেনগুলো) {
        লেখো(লেখায়(t.লাইন) + ":" + লেখায়(t.কলাম) + "  " + ধরন_দেখাও(t.ধরন))
    }
    প্রতি (d : l.ত্রুটিগুলো) {
        লেখো("ত্রুটি " + লেখায়(d.লাইন) + ":" + লেখায়(d.কলাম) + " " + d.বার্তা)
    }
}

অ্যাপ {
    ডাম্প("ধরি ক১ = ১২৩ + 4.5  // মন্তব্য\nফাংশন চল() { লেখো(\"হ্যালো\") }\n")
}
