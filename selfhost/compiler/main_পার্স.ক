ফাংশন প্রোগ্রাম_সারাংশ(প্রোগ্রাম prog) -> লেখা {
    ধরি s = ""
    s = s + "imports=" + লেখায়(দৈর্ঘ্য(prog.ইম্পোর্টগুলো)) + " "
    s = s + "structs=" + লেখায়(দৈর্ঘ্য(prog.স্ট্রাক্টগুলো)) + " "
    s = s + "enums=" + লেখায়(দৈর্ঘ্য(prog.এনামগুলো)) + " "
    s = s + "funcs=" + লেখায়(দৈর্ঘ্য(prog.ফাংশনগুলো)) + " "
    s = s + "externs=" + লেখায়(দৈর্ঘ্য(prog.এক্সটার্নগুলো)) + " "
    s = s + "consts=" + লেখায়(দৈর্ঘ্য(prog.ধ্রুবকগুলো)) + " "
    যদি (আছে_বি(prog.অ্যাপ_ঘোষণা)) {
        s = s + "app=1"
    } নাহলে {
        s = s + "app=0"
    }
    রিটার্ন s
}

অ্যাপ {
    ধরি আর্গ = সিস্টেম.আর্গুমেন্ট()
    যদি (দৈর্ঘ্য(আর্গ) == ০) {
        লেখো("ব্যবহার: kolom চালাও selfhost/compiler/main_পার্স.ক <ফাইল>")
    } নাহলে {
        ধরি উৎস = ফাইল.পড়ো(আর্গ[০])
        ধরি l = লেক্স(উৎস)
        ধরি p = পার্সার_বানাও(l.টোকেনগুলো)
        ধরি prog = পার্স_প্রোগ্রাম(p)
        লেখো(প্রোগ্রাম_সারাংশ(prog))
        লেখো("diagnostics=" + লেখায়(দৈর্ঘ্য(p.ত্রুটিগুলো)))
        প্রতি (d : p.ত্রুটিগুলো) {
            লেখো("ERR\t" + লেখায়(d.লাইন) + "\t" + লেখায়(d.কলাম) + "\t" + d.বার্তা)
        }
    }
}
