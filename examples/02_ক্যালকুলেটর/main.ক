// ফাংশন, কন্ট্রোল ফ্লো — সাধারণ ও দশমিক সংখ্যা নিয়ে একটি ছোট ক্যালকুলেটর

ফাংশন যোগ(সংখ্যা ক, সংখ্যা খ) -> সংখ্যা {
    রিটার্ন ক + খ
}

ফাংশন গড়(সংখ্যা ক, সংখ্যা খ, সংখ্যা গ) -> দশমিক {
    রিটার্ন (ক + খ + গ) / ৩.০
}

ফাংশন গ্রেড(সংখ্যা নম্বর) -> লেখা {
    যদি (নম্বর >= ৮০) {
        রিটার্ন "A+"
    } নাহলে যদি (নম্বর >= ৭০) {
        রিটার্ন "A"
    } নাহলে যদি (নম্বর >= ৬০) {
        রিটার্ন "B"
    } নাহলে {
        রিটার্ন "C"
    }
}

অ্যাপ {

    লেখো("যোগফল: " + লেখায়(যোগ(১৫, ২৭)))

    লেখো("গড়: " + লেখায়(গড়(৮৫, ৭২, ৯১)))

    ধরি নম্বর = ৭৫

    লেখো("নম্বর " + লেখায়(নম্বর) + " এর গ্রেড: " + গ্রেড(নম্বর))

    // ১ থেকে ১০ পর্যন্ত জোড়/বিজোড় দেখানো
    ধরি গণনা = ১

    যতক্ষণ (গণনা <= ১০) {

        যদি ((গণনা % ২) == ০) {
            লেখো(লেখায়(গণনা) + " জোড়")
        } নাহলে {
            লেখো(লেখায়(গণনা) + " বিজোড়")
        }

        গণনা = গণনা + ১

    }

}
