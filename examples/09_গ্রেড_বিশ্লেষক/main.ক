// পরিসংখ্যান, সাজাও, সিস্টেম, সময়, সংখ্যায়/দশমিকে — একটি ছোট গ্রেড-বিশ্লেষণ টুল
// (একটি ক্লাসের নম্বর নিয়ে পরিসংখ্যান বের করে, গ্রেড দেয়, উত্তীর্ণ/অনুত্তীর্ণ গোনে)

ইম্পোর্ট পরিসংখ্যান
ইম্পোর্ট সিস্টেম
ইম্পোর্ট সময়
ইম্পোর্ট গণিত

ফাংশন গ্রেড(দশমিক নম্বর) -> লেখা {
    যদি (নম্বর >= ৯০) {
        রিটার্ন "A+"
    } নাহলে যদি (নম্বর >= ৮০) {
        রিটার্ন "A"
    } নাহলে যদি (নম্বর >= ৭০) {
        রিটার্ন "B"
    } নাহলে যদি (নম্বর >= ৬০) {
        রিটার্ন "C"
    } নাহলে {
        রিটার্ন "অকৃতকার্য"
    }
}

অ্যাপ {

    ধরি ছাত্র = ["রাহুল", "মিনা", "করিম", "সুমি", "তানভীর", "নাজিয়া"]
    ধরি নম্বর = [78.0, 92.0, 85.0, 64.0, 99.0, 55.0]

    // কমান্ড-লাইনে একটা আর্গুমেন্ট দিলে সেটাই উত্তীর্ণের সীমা হবে, না দিলে ডিফল্ট ৬০
    ধরি আর্গ = সিস্টেম.আর্গুমেন্ট()
    ধরি সীমা = 60.0
    যদি (দৈর্ঘ্য(আর্গ) > ০) {
        চেষ্টা {
            সীমা = দশমিকে(আর্গ[০])
        } ধরো (e) {
            লেখো("সতর্কতা: '" + আর্গ[০] + "' বৈধ সংখ্যা নয়, ডিফল্ট সীমা (৬০) ব্যবহার করা হচ্ছে")
        }
    }

    লেখো("=== গ্রেড বিশ্লেষণ প্রতিবেদন ===")
    লেখো("তারিখ: " + সময়.বর্তমান_তারিখ_লেখা())
    লেখো("উত্তীর্ণের সীমা: " + লেখায়(সীমা))
    লেখো("---")

    ধরি i = ০
    ধরি উত্তীর্ণ_সংখ্যা = ০

    যতক্ষণ (i < দৈর্ঘ্য(ছাত্র)) {
        ধরি ফল = নম্বর[i]
        ধরি অবস্থা = "উত্তীর্ণ"
        যদি (ফল < সীমা) {
            অবস্থা = "অনুত্তীর্ণ"
        } নাহলে {
            উত্তীর্ণ_সংখ্যা = উত্তীর্ণ_সংখ্যা + ১
        }
        লেখো(ছাত্র[i] + ": " + লেখায়(ফল) + " (" + গ্রেড(ফল) + ", " + অবস্থা + ")")
        i = i + ১
    }

    লেখো("---")
    ধরি সাজানো_নম্বর = সাজাও(নম্বর)
    লেখো("সাজানো নম্বর:")
    লেখো(সাজানো_নম্বর)

    লেখো("গড়: " + লেখায়(পরিসংখ্যান.গড়(নম্বর)))
    লেখো("গড় (রাউন্ড করা): " + লেখায়(গণিত.রাউন্ডঅফ(পরিসংখ্যান.গড়(নম্বর))))
    লেখো("মধ্যক: " + লেখায়(পরিসংখ্যান.মধ্যক(নম্বর)))
    লেখো("আদর্শ বিচ্যুতি: " + লেখায়(পরিসংখ্যান.আদর্শ_বিচ্যুতি(নম্বর)))
    লেখো("উত্তীর্ণ: " + লেখায়(উত্তীর্ণ_সংখ্যা) + "/" + লেখায়(দৈর্ঘ্য(ছাত্র)))

}
