// ম্যাপ ও প্রতি (for-each) — একটি কেনাকাটার তালিকা ও তার মোট দাম

অ্যাপ {

    ধরি দাম: ম্যাপ[লেখা, সংখ্যা] = ম্যাপ_তৈরি()

    দাম["চাল"] = ৬৫
    দাম["ডাল"] = ১২০
    দাম["তেল"] = ১৮০
    দাম["চিনি"] = ৫৫

    ধরি পণ্যসমূহ = চাবি_গুলো(দাম)

    ধরি মোট = ০

    প্রতি (নাম : পণ্যসমূহ) {

        ধরি মূল্য = দাম[নাম]

        লেখো(নাম + " — " + লেখায়(মূল্য) + " টাকা")

        মোট = মোট + মূল্য

    }

    লেখো("---")
    লেখো("মোট আইটেম: " + লেখায়(দৈর্ঘ্য(দাম)))
    লেখো("সর্বমোট: " + লেখায়(মোট) + " টাকা")

}
