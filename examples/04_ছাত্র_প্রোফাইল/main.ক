// ডাটা (Structs) — নেস্টেড স্ট্রাক্ট, ফাংশনে প্যারামিটার/রিটার্ন টাইপ হিসেবে

ডাটা ঠিকানা {
    শহর: লেখা,
    জেলা: লেখা
}

ডাটা ছাত্র {
    নাম: লেখা,
    নম্বর: সংখ্যা,
    বাসা: ঠিকানা
}

ফাংশন গ্রেড_বের_করো(সংখ্যা নম্বর) -> লেখা {
    যদি (নম্বর >= ৮০) {
        ফেরাও "A+"
    } নাহলে যদি (নম্বর >= ৬০) {
        ফেরাও "A"
    } নাহলে {
        ফেরাও "B"
    }
}

ফাংশন উত্তীর্ণ_করো(ছাত্র জন, সংখ্যা বাড়তি_নম্বর) -> ছাত্র {
    ফেরাও ছাত্র(জন.নাম, জন.নম্বর + বাড়তি_নম্বর, জন.বাসা)
}

অ্যাপ {

    ধরি রহিম = ছাত্র("রহিম", ৭৫, ঠিকানা("ঢাকা", "ঢাকা"))

    লেখো(রহিম.নাম + " থাকে " + রহিম.বাসা.শহর + "-তে")
    লেখো("নম্বর: " + লেখায়(রহিম.নম্বর) + ", গ্রেড: " + গ্রেড_বের_করো(রহিম.নম্বর))

    ধরি রহিম২ = উত্তীর্ণ_করো(রহিম, ১০)

    লেখো("বাড়তি নম্বরের পর: " + লেখায়(রহিম২.নম্বর) + ", গ্রেড: " + গ্রেড_বের_করো(রহিম২.নম্বর))

    // ফিল্ড সরাসরি বদলানো
    রহিম.নম্বর = ৯০

    লেখো(রহিম.নাম + " এখন পেয়েছে " + লেখায়(রহিম.নম্বর))

}
