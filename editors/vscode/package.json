{
  "name": "kolom",
  "displayName": "Kolom (কলম)",
  "description": "Syntax highlighting for Kolom, a Bengali programming language",
  "version": "0.1.0",
  "publisher": "kolom-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raselalmamun360/kolom"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "kolom",
        "aliases": ["Kolom", "কলম"],
        "extensions": [".ক"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kolom",
        "scopeName": "source.kolom",
        "path": "./syntaxes/kolom.tmLanguage.json"
      }
    ]
  }
}
