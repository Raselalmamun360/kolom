{
  "name": "kolom",
  "displayName": "Kolom (কলম)",
  "description": "Syntax highlighting and diagnostics for Kolom, a Bengali programming language",
  "version": "0.7.0",
  "icon": "icon.png",
  "publisher": "kolom-lang",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Raselalmamun360/kolom"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kolom",
        "aliases": ["Kolom", "কলম"],
        "extensions": [".ক"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kolom",
        "scopeName": "source.kolom",
        "path": "./syntaxes/kolom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Kolom",
      "properties": {
        "kolom.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kolom-lsp executable. Leave empty to auto-detect: looks next to whichever `kolom`/`kolom.exe` is on PATH first, then falls back to a bare `kolom-lsp` on PATH."
        },
        "kolom.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kolom CLI executable, used by 'Kolom: Console-এ চালাও'. Leave empty to auto-detect from PATH."
        }
      }
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "kolomConsolePanel",
          "title": "কলম কনসোল",
          "icon": "resources/console-icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "kolomSidebar",
          "title": "কলম",
          "icon": "resources/console-icon.svg"
        }
      ]
    },
    "views": {
      "kolomConsolePanel": [
        {
          "id": "kolom.consoleView",
          "name": "",
          "type": "webview"
        }
      ],
      "kolomSidebar": [
        {
          "id": "kolom.consoleViewSidebar",
          "name": "কনসোল",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "kolom.runInConsole",
        "title": "Kolom: Console-এ চালাও",
        "icon": "$(play)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
