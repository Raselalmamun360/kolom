অ্যাপ {
    ধরি উৎস = "অ্যাপ {
    লেখো(\"হ্যালো\")
}"
    ধরি l = লেক্স(উৎস)
    ধরি p = পার্সার_বানাও(l.টোকেনগুলো)
    ধরি prog = পার্স_প্রোগ্রাম(p)
    লেখো("imports=" + লেখায়(দৈর্ঘ্য(prog.ইম্পোর্টগুলো)))
    লেখো("structs=" + লেখায়(দৈর্ঘ্য(prog.স্ট্রাক্টগুলো)))
    লেখো("enums=" + লেখায়(দৈর্ঘ্য(prog.এনামগুলো)))
    লেখো("funcs=" + লেখায়(দৈর্ঘ্য(prog.ফাংশনগুলো)))
    লেখো("diagnostics=" + লেখায়(দৈর্ঘ্য(p.ত্রুটিগুলো)))
}
