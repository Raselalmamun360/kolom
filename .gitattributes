# Kolom source and test data are compared byte-for-byte, so they must not be
# line-ending-converted on checkout. Without this, a Windows clone rewrites
# `expected.txt` to CRLF while the compiler emits LF, and every golden test
# fails on a fresh checkout for reasons that look nothing like the cause.
*.ক            text eol=lf
expected.txt   text eol=lf

# Rust, docs, and build scripts: normalize in the repository, and keep LF on
# checkout so behaviour matches CI and Linux contributors.
*.rs           text eol=lf
*.md           text eol=lf
*.toml         text eol=lf
*.sh           text eol=lf
*.txt          text eol=lf

# Binary — never touch.
*.png          binary
*.jpg          binary
*.ico          binary
*.a            binary
*.lib          binary
*.exe          binary
*.o            binary
*.obj          binary
